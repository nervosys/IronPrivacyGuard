{
  "$defs": {
    "Algorithm": {
      "description": "Key shape for `openpgp.key.generate`.",
      "oneOf": [
        {
          "const": "ed25519",
          "description": "Ed25519 primary key (certify, sign) and Curve25519 ECDH subkey, as GnuPG\ncreates by default. Signatures use SHA-512.",
          "type": "string"
        },
        {
          "const": "p384",
          "description": "ECDSA P-384 primary key and ECDH P-384 subkey with SHA-384 and AES-256\n(CNSA-aligned).",
          "type": "string"
        }
      ]
    },
    "AttestationReport": {
      "description": "What a verified attestation establishes.",
      "properties": {
        "activation_verified": {
          "description": "The AK and EK proved to share a TPM (credential activation); false for\nevidence checked without a response.",
          "type": "boolean"
        },
        "ek_certificate_anchor": {
          "description": "SHA-256 of the trust anchor certificate the chain ended at, lowercase hex.",
          "type": "string"
        },
        "ek_certificate_sha256": {
          "description": "SHA-256 of the EK certificate, lowercase hex.",
          "type": "string"
        },
        "fingerprint": {
          "description": "64 hex characters for ipg-public-v1 identities, 96 for P-384, P-384 plus ML-DSA and hybrid identities.",
          "maxLength": 96,
          "minLength": 64,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{64}|[0-9a-f]{96})$",
          "type": "string"
        },
        "firmware_version": {
          "description": "TPM firmware version reported in the certifications.",
          "type": "string"
        },
        "key_attributes": {
          "description": "Attributes both keys carry: fixedTPM, fixedParent, sensitiveDataOrigin.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "fingerprint",
        "ek_certificate_sha256",
        "ek_certificate_anchor",
        "firmware_version",
        "key_attributes",
        "activation_verified"
      ],
      "type": "object"
    },
    "Authority": {
      "description": "The authority a verified chain confers on its final subject.",
      "properties": {
        "checked_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "delegation_depth": {
          "format": "uint8",
          "minimum": 0,
          "type": "integer"
        },
        "links": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "not_after": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "not_before": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "purposes": {
          "description": "Empty when the chain places no purpose restriction.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "description": "64 hex characters for ipg-public-v1 identities, 96 for P-384, P-384 plus ML-DSA and hybrid identities.",
          "maxLength": 96,
          "minLength": 64,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{64}|[0-9a-f]{96})$",
          "type": "string"
        },
        "subject": {
          "description": "64 hex characters for ipg-public-v1 identities, 96 for P-384, P-384 plus ML-DSA and hybrid identities.",
          "maxLength": 96,
          "minLength": 64,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{64}|[0-9a-f]{96})$",
          "type": "string"
        }
      },
      "required": [
        "root",
        "subject",
        "operations",
        "purposes",
        "not_before",
        "not_after",
        "delegation_depth",
        "links",
        "checked_at"
      ],
      "type": "object"
    },
    "Certificate": {
      "description": "Certificate evaluated under IPG policy at `evaluated_at` (host time).",
      "properties": {
        "created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "evaluated_at": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expired": {
          "type": "boolean"
        },
        "expires": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fingerprint": {
          "maxLength": 64,
          "minLength": 40,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/ComponentKey"
          },
          "type": "array"
        },
        "revoked": {
          "type": "boolean"
        },
        "usable_for_encryption": {
          "type": "boolean"
        },
        "usable_for_signing": {
          "type": "boolean"
        },
        "user_ids": {
          "description": "User IDs with a valid, unrevoked self-certification. Self-asserted and\nunverified: they are labels, not identity proof.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "fingerprint",
        "created",
        "revoked",
        "expired",
        "evaluated_at",
        "user_ids",
        "usable_for_encryption",
        "usable_for_signing",
        "keys"
      ],
      "type": "object"
    },
    "Change": {
      "oneOf": [
        {
          "properties": {
            "after": {
              "type": "string"
            },
            "before": {
              "type": "string"
            },
            "change": {
              "const": "format_changed",
              "type": "string"
            }
          },
          "required": [
            "change",
            "before",
            "after"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "identity_order_changed",
              "type": "string"
            }
          },
          "required": [
            "change"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "validity_certificate_replaced",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "identity_added",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "identity_removed",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "revocation_added",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "revocation_removed",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "change": {
              "const": "revocation_replaced",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "fingerprint"
          ],
          "type": "object"
        },
        {
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Window"
                },
                {
                  "type": "null"
                }
              ]
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Window"
                },
                {
                  "type": "null"
                }
              ]
            },
            "change": {
              "const": "validity_changed",
              "type": "string"
            },
            "fingerprint": {
              "type": "string"
            },
            "relation": {
              "$ref": "#/$defs/WindowRelation"
            }
          },
          "required": [
            "change",
            "fingerprint",
            "relation"
          ],
          "type": "object"
        }
      ]
    },
    "Cipher": {
      "enum": [
        "chacha20-poly1305",
        "aes-256-gcm"
      ],
      "type": "string"
    },
    "Comparison": {
      "properties": {
        "base_digest": {
          "type": "string"
        },
        "candidate_digest": {
          "type": "string"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "type": "array"
        },
        "compatible_extension": {
          "description": "Structural extension only, not authorization to enroll added identities.",
          "type": "boolean"
        },
        "same_digest": {
          "type": "boolean"
        }
      },
      "required": [
        "base_digest",
        "candidate_digest",
        "same_digest",
        "compatible_extension",
        "changes"
      ],
      "type": "object"
    },
    "ComponentKey": {
      "description": "A primary key or subkey and why it is or is not usable.",
      "properties": {
        "algorithm": {
          "description": "For example ed25519, ecdsa-p384, ecdh-cv25519, ecdh-p384 or rsa-3072.",
          "type": "string"
        },
        "bound": {
          "description": "A valid binding self-signature (and, for signing subkeys, back signature) exists.",
          "type": "boolean"
        },
        "created": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "expires": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "fingerprint": {
          "maxLength": 64,
          "minLength": 40,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "flags": {
          "description": "Key flags from the binding signature: certify, sign, encrypt, authenticate.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "primary": {
          "type": "boolean"
        },
        "revoked": {
          "type": "boolean"
        },
        "usable_for_encryption": {
          "type": "boolean"
        },
        "usable_for_signing": {
          "type": "boolean"
        }
      },
      "required": [
        "fingerprint",
        "primary",
        "algorithm",
        "created",
        "revoked",
        "bound",
        "flags",
        "usable_for_encryption",
        "usable_for_signing",
        "issues"
      ],
      "type": "object"
    },
    "Custody": {
      "description": "Where a private-key operation ran. Reported only as evidence from this process;\ncounterparties cannot verify it from public artifacts.",
      "oneOf": [
        {
          "enum": [
            "software"
          ],
          "type": "string"
        },
        {
          "const": "hardware",
          "description": "A local PKCS#11 token or TPM.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "A managed key service (AWS KMS); keys never leave the service.",
          "type": "string"
        }
      ]
    },
    "Eligibility": {
      "enum": [
        "permitted",
        "revoked",
        "not_yet_valid",
        "expired"
      ],
      "type": "string"
    },
    "Inventory": {
      "properties": {
        "library": {
          "$ref": "#/$defs/LibraryInfo"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/TokenReport"
          },
          "type": "array"
        }
      },
      "required": [
        "library",
        "tokens"
      ],
      "type": "object"
    },
    "Issue": {
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "description": "JSON Pointer relative to the candidate Request; empty means its root.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "code",
        "message"
      ],
      "type": "object"
    },
    "LibraryInfo": {
      "properties": {
        "cryptoki_version": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "library_version": {
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "manufacturer",
        "library_version",
        "cryptoki_version"
      ],
      "type": "object"
    },
    "MechanismSupport": {
      "properties": {
        "ec_key_pair_generation": {
          "type": "boolean"
        },
        "ecdh_derive": {
          "type": "boolean"
        },
        "ecdsa": {
          "type": "boolean"
        }
      },
      "required": [
        "ec_key_pair_generation",
        "ecdsa",
        "ecdh_derive"
      ],
      "type": "object"
    },
    "Protection": {
      "description": "Evidence read from the token about both private keys. Never an attestation:\nthe token itself reports these attributes.",
      "properties": {
        "generated_on_token": {
          "description": "CKA_LOCAL, CKA_ALWAYS_SENSITIVE and CKA_NEVER_EXTRACTABLE are all true.",
          "type": "boolean"
        },
        "non_exportable": {
          "description": "CKA_SENSITIVE is true and CKA_EXTRACTABLE is false for both private keys.",
          "type": "boolean"
        },
        "possession_verified": {
          "description": "Token signed and agreed keys matching the bound public identity.",
          "type": "boolean"
        }
      },
      "required": [
        "non_exportable",
        "generated_on_token",
        "possession_verified"
      ],
      "type": "object"
    },
    "RecipientKeys": {
      "description": "The keys a message was encrypted to, per recipient certificate.",
      "properties": {
        "encryption_keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fingerprint": {
          "maxLength": 64,
          "minLength": 40,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "encryption_keys"
      ],
      "type": "object"
    },
    "RevocationReason": {
      "enum": [
        "compromised",
        "superseded",
        "retired"
      ],
      "type": "string"
    },
    "TokenBinding": {
      "additionalProperties": false,
      "description": "Token identity copied from PKCS#11 token information, trailing blanks removed.\nEvery field must match before a reference is used.",
      "properties": {
        "label": {
          "maxLength": 32,
          "type": "string"
        },
        "manufacturer": {
          "maxLength": 32,
          "type": "string"
        },
        "model": {
          "maxLength": 16,
          "type": "string"
        },
        "serial": {
          "description": "PKCS#11 token serial number exactly as reported by hardware.tokens",
          "maxLength": 16,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "serial",
        "label",
        "manufacturer",
        "model"
      ],
      "type": "object"
    },
    "TokenReport": {
      "properties": {
        "hardware_slot": {
          "type": "boolean"
        },
        "login_required": {
          "type": "boolean"
        },
        "mechanisms": {
          "$ref": "#/$defs/MechanismSupport"
        },
        "removable": {
          "type": "boolean"
        },
        "slot": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "suites": {
          "description": "Identity formats whose mechanisms the token advertises. Advisory: curve and\npolicy restrictions are only discovered when keys are created or used.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "token": {
          "$ref": "#/$defs/TokenBinding"
        },
        "token_initialized": {
          "type": "boolean"
        },
        "user_pin_initialized": {
          "type": "boolean"
        }
      },
      "required": [
        "slot",
        "token",
        "token_initialized",
        "user_pin_initialized",
        "login_required",
        "hardware_slot",
        "removable",
        "mechanisms",
        "suites"
      ],
      "type": "object"
    },
    "TpmBinding": {
      "additionalProperties": false,
      "description": "TPM identification read from its properties. Informational: the wrapped blobs\nthemselves only load under the storage root of the TPM that created them.",
      "properties": {
        "manufacturer": {
          "maxLength": 4,
          "type": "string"
        },
        "vendor": {
          "maxLength": 16,
          "type": "string"
        }
      },
      "required": [
        "manufacturer",
        "vendor"
      ],
      "type": "object"
    },
    "TpmInfo": {
      "description": "TPM properties relevant to IPG identities.",
      "properties": {
        "backend": {
          "description": "\"native-tpm2\" (Linux) or \"cng\" (Windows Platform Crypto Provider).",
          "type": "string"
        },
        "curves": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "firmware_version": {
          "type": "string"
        },
        "owner_auth_empty": {
          "description": "Linux only: whether the owner hierarchy has empty authorization.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "suites": {
          "description": "Identity formats this TPM can hold; empty when P-384 is unsupported.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tpm": {
          "$ref": "#/$defs/TpmBinding"
        }
      },
      "required": [
        "tpm",
        "firmware_version",
        "curves",
        "suites",
        "backend"
      ],
      "type": "object"
    },
    "Validation": {
      "properties": {
        "execution": {
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "type": "array"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "issues",
        "truncated",
        "execution"
      ],
      "type": "object"
    },
    "Verification": {
      "description": "An authenticated detached signature.",
      "properties": {
        "certificate_expired_now": {
          "description": "The certificate is expired at host time; the signature predates expiry.",
          "type": "boolean"
        },
        "created": {
          "description": "Signature creation time claimed by the signer.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "fingerprint": {
          "maxLength": 64,
          "minLength": 40,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        },
        "hash_algorithm": {
          "type": "string"
        },
        "signing_key": {
          "description": "The primary key or subkey that made the signature.",
          "maxLength": 64,
          "minLength": 40,
          "not": {
            "pattern": "[^0-9a-f]"
          },
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "signing_key",
        "created",
        "hash_algorithm",
        "certificate_expired_now"
      ],
      "type": "object"
    },
    "Window": {
      "properties": {
        "not_after": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "not_before": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "not_before",
        "not_after"
      ],
      "type": "object"
    },
    "WindowRelation": {
      "enum": [
        "unchanged",
        "added",
        "removed",
        "narrowed",
        "widened",
        "incomparable"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "request_validation",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/Validation"
        }
      },
      "required": [
        "kind",
        "validation"
      ],
      "type": "object"
    },
    {
      "properties": {
        "comparison": {
          "$ref": "#/$defs/Comparison"
        },
        "kind": {
          "const": "trust_comparison",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "comparison"
      ],
      "type": "object"
    },
    {
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string"
        },
        "kind": {
          "const": "validity_verified",
          "type": "string"
        },
        "not_after": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "not_before": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "policy_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "fingerprint",
        "not_before",
        "not_after",
        "authenticated",
        "policy_applied"
      ],
      "type": "object"
    },
    {
      "properties": {
        "advisory": {
          "type": "boolean"
        },
        "at_time": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "type": "string"
        },
        "eligibility": {
          "$ref": "#/$defs/Eligibility"
        },
        "fingerprint": {
          "type": "string"
        },
        "kind": {
          "const": "trust_evaluation",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fingerprint",
        "digest",
        "at_time",
        "eligibility",
        "advisory"
      ],
      "type": "object"
    },
    {
      "properties": {
        "digest": {
          "type": "string"
        },
        "identities": {
          "format": "uint",
