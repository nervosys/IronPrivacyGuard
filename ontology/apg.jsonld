        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "openpgp.decrypt",
      "inputs": [
