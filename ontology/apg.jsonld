      ],
      "key_inputs": [],
      "mcp_tool": "apg_openpgp_decrypt",
      "optional_inputs": [],
      "outputs": [
        "apg:Plaintext"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "openpgp.decrypt"
      },
      "retry": "Do not retry blindly; inspect the destination after an ambiguous transport failure. Existing outputs are never replaced."
    },
    {
      "@id": "apg:operation/openpgp.sign",
      "@type": "apg:Operation",
      "algorithms": [
        "ic:argon2id",
        "ic:chacha20-poly1305"
      ],
      "conditional_effects": [],
      "constraints": [
