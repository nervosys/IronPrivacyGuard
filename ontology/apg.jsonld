        "pin_locked"
      ],
      "id": "openpgp.encrypt",
      "inputs": [
        "apg:Plaintext",
        "apg:OpenpgpCertificate",
        "apg:OpenpgpFingerprint"
      ],
      "key_inputs": [],
      "mcp_tool": "apg_openpgp_encrypt",
      "optional_inputs": [],
      "outputs": [
        "apg:OpenpgpMessage"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "openpgp.encrypt"
      },
      "retry": "Do not retry blindly; inspect the destination after an ambiguous transport failure. Existing outputs are never replaced."
    },
    {
      "@id": "apg:operation/openpgp.decrypt",
      "@type": "apg:Operation",
      "algorithms": [
        "ic:argon2id",
        "ic:chacha20-poly1305"
      ],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/openpgp-boundary",
        "apg:constraint/authenticate-before-release",
        "apg:constraint/openpgp-embedded-signatures",
        "apg:constraint/secret-channel",
        "apg:constraint/no-clobber",
        "apg:constraint/openpgp-size-bound"
      ],
      "description": "Decrypt an integrity-protected OpenPGP message with an APG-held OpenPGP key",
      "deterministic": true,
      "effects": [
        "read_file",
        "read_passphrase",
        "create_file"
      ],
      "errors": [
        "invalid_request",
