    },
    {
      "@id": "apg:operation/openpgp.verify",
      "@type": "apg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/openpgp-boundary",
        "apg:constraint/openpgp-pin",
        "apg:constraint/openpgp-certificate-policy",
        "apg:constraint/exact-bytes"
      ],
      "description": "Verify a detached OpenPGP signature against a pinned certificate under APG policy",
      "deterministic": false,
      "effects": [
        "read_file"
      ],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
