{
  "@context": {
    "@vocab": "urn:apg:v1:",
    "algorithms": {
      "@type": "@id"
    },
    "apg": "urn:apg:v1:",
    "constraints": {
      "@type": "@id"
    },
    "goals": {
      "@type": "@id"
    },
    "ic": "urn:ironcrypto:algorithm:",
    "inputs": {
      "@type": "@id"
    },
    "optional_inputs": {
      "@type": "@id"
    },
    "outputs": {
      "@type": "@id"
    },
    "sources": {
      "@type": "@id"
    },
    "tools": {
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "apg:KnowledgeQuery",
      "@type": "apg:Entity",
      "description": "1..256 Unicode characters with an alphanumeric token; deterministic keyword search",
      "sensitivity": "control"
    },
    {
      "@id": "apg:KnowledgeBase",
      "@type": "apg:Entity",
      "description": "Centralized curated application guidance and tool mappings",
      "sensitivity": "control"
    },
    {
      "@id": "apg:KnowledgeSelection",
      "@type": "apg:Entity",
      "description": "Deterministic keyword matches; not approval or authorization",
      "sensitivity": "control"
    },
    {
      "@id": "apg:CandidateRequest",
      "@type": "apg:Entity",
      "description": "Untrusted JSON proposed as an APG Request object; not a Call envelope",
      "sensitivity": "untrusted"
    },
    {
      "@id": "apg:RequestValidation",
      "@type": "apg:Entity",
      "description": "Static preflight issues with JSON Pointers; no authentication or authorization claim",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TrustComparison",
      "@type": "apg:Entity",
      "description": "Ordered snapshot changes and structural extension compatibility; not approval or a freshness proof",
      "sensitivity": "control"
    },
    {
      "@id": "apg:Validity",
      "@type": "apg:Entity",
      "description": "Self-signed entire-identity half-open validity window [not_before, not_after)",
      "sensitivity": "public"
    },
    {
      "@id": "apg:UnixTime",
      "@type": "apg:Entity",
      "description": "Integer Unix seconds from 0 through 253402300799",
      "sensitivity": "control"
    },
    {
      "@id": "apg:ValidityVerification",
      "@type": "apg:Entity",
      "description": "Authenticated validity evidence; does not apply policy",
      "sensitivity": "public"
    },
    {
      "@id": "apg:TrustEvaluation",
      "@type": "apg:Entity",
      "description": "Advisory permitted, revoked, not_yet_valid or expired at a supplied time",
      "sensitivity": "control"
    },
    {
      "@id": "apg:McpTransport",
      "@type": "apg:Entity",
      "description": "Newline-delimited JSON-RPC stdio; initialize, initialized notification, ping, tools/list and tools/call",
      "sensitivity": "control"
    },
    {
      "@id": "apg:McpHostPolicy",
      "@type": "apg:Entity",
      "description": "Startup-selected trust snapshot injected into encrypt, sign and verify, and optional hardware key custody requirement; tool callers cannot replace either",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TokenInventory",
      "@type": "apg:Entity",
      "description": "Tokens visible through the host-configured PKCS#11 module with advertised mechanisms; advisory, no login",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TokenSerial",
      "@type": "apg:Entity",
      "description": "PKCS#11 token serial number selecting exactly one present token",
      "sensitivity": "control"
    },
    {
      "@id": "apg:KeyLabel",
      "@type": "apg:Entity",
      "description": "CKA_LABEL of 1..64 bytes written to generated token objects; informational, never used for lookup",
      "sensitivity": "control"
    },
    {
      "@id": "apg:KeyId",
      "@type": "apg:Entity",
      "description": "PKCS#11 CKA_ID of 1..64 bytes identifying one key pair's public and private objects",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TokenPin",
      "@type": "apg:Entity",
      "description": "Token user PIN, 1..255 exact file bytes; never a request value",
      "sensitivity": "secret"
    },
    {
      "@id": "apg:KeyDeletion",
      "@type": "apg:Entity",
      "description": "Confirmation that a TPM-backed identity's persisted keys were permanently deleted",
      "sensitivity": "control"
    },
    {
      "@id": "apg:StreamCiphertext",
      "@type": "apg:Entity",
      "description": "apg-stream-v1: a binary stream with a header wrapping one content key for each of 1..64 recipients and authenticated 64 KiB chunks; does not identify a sender",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "apg:TpmEvidence",
      "@type": "apg:Entity",
      "description": "apg-tpm-evidence-v1: the identity, the TPM's EK public area and certificates, its attestation key and two TPM2_Certify certifications; public, and not a proof until verified with a credential challenge",
      "sensitivity": "public"
    },
    {
      "@id": "apg:TrustAnchors",
      "@type": "apg:Entity",
      "description": "Root certificates (PEM or DER) of the TPM manufacturers the verifier accepts, chosen by the verifier",
      "sensitivity": "public"
    },
    {
      "@id": "apg:TpmChallenge",
      "@type": "apg:Entity",
      "description": "apg-tpm-challenge-v1: a credential encrypted to the TPM's endorsement key for the evidence's attestation key (software TPM2_MakeCredential)",
      "sensitivity": "public"
    },
    {
      "@id": "apg:TpmChallengeSecret",
      "@type": "apg:Entity",
      "description": "apg-tpm-challenge-secret-v1: the verifier's copy of the challenge credential; keep private and use once",
      "sensitivity": "secret"
    },
    {
      "@id": "apg:TpmAttestationResponse",
      "@type": "apg:Entity",
      "description": "apg-tpm-response-v1: the credential the TPM released through TPM2_ActivateCredential",
      "sensitivity": "public"
    },
    {
      "@id": "apg:AttestationReport",
      "@type": "apg:Entity",
      "description": "What a verification established: EK certificate and anchor digests, TPM firmware, key attributes (fixedTPM, fixedParent, sensitiveDataOrigin) and whether the credential activation was verified",
      "sensitivity": "control"
    },
    {
      "@id": "apg:OpenpgpKeyFile",
      "@type": "apg:Entity",
      "description": "apg-openpgp-key-v1: a v4 OpenPGP key generated by APG whose transferable secret key is sealed with Argon2id and ChaCha20-Poly1305; the certificate is public",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "apg:OpenpgpCertificate",
      "@type": "apg:Entity",
      "description": "An OpenPGP certificate (transferable public key) file, ASCII-armored or binary; untrusted until pinned by fingerprint",
      "sensitivity": "public"
    },
    {
      "@id": "apg:OpenpgpFingerprint",
      "@type": "apg:Entity",
      "description": "v4 OpenPGP primary-key fingerprint: 40 hexadecimal characters, either case; distinct from APG fingerprints",
      "sensitivity": "public"
    },
    {
      "@id": "apg:OpenpgpUserId",
      "@type": "apg:Entity",
      "description": "Self-asserted OpenPGP User ID label such as \"Alice <alice@example.org>\"; 1..256 bytes without control characters; never identity proof",
      "sensitivity": "untrusted"
    },
    {
      "@id": "apg:OpenpgpMessage",
      "@type": "apg:Entity",
      "description": "ASCII-armored or binary OpenPGP message; APG writes armored SEIPDv1 messages with AES-256",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "apg:OpenpgpSignature",
      "@type": "apg:Entity",
      "description": "Detached OpenPGP document signature, ASCII-armored or binary",
      "sensitivity": "public"
    },
    {
      "@id": "apg:OpenpgpCertificateReport",
      "@type": "apg:Entity",
      "description": "A certificate evaluated under APG policy at host time: per-key algorithm, flags, expiry, revocation, usability and issues",
      "sensitivity": "control"
    },
    {
      "@id": "apg:OpenpgpVerification",
      "@type": "apg:Entity",
      "description": "A valid detached OpenPGP signature by a key of the pinned certificate that was valid for signing when it signed; no identity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "apg:KmsKeyFile",
      "@type": "apg:Entity",
      "description": "Public apg-kms-key-v1 file binding an identity to AWS KMS key ARNs in one region: two P-384 keys (apg-public-p384-v1), plus an ML_DSA_65 key for composite post-quantum signatures (apg-public-p384-mldsa65-v1); using it needs host AWS credentials",
      "sensitivity": "public"
    },
    {
      "@id": "apg:AwsRegion",
      "@type": "apg:Entity",
      "description": "AWS region holding both KMS keys, for example us-gov-west-1",
      "sensitivity": "control"
    },
    {
      "@id": "apg:KmsKeyArn",
      "@type": "apg:Entity",
      "description": "Exact KMS key ARN; aliases are refused because they can be repointed",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TpmInventory",
      "@type": "apg:Entity",
      "description": "Host TPM manufacturer, vendor, firmware, supported curves and owner-hierarchy readiness; advisory",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TpmKeyFile",
      "@type": "apg:Entity",
      "description": "Host TPM key file for a P-384 identity: apg-tpm-key-v1 (Linux) holds TPM-wrapped fixedTPM blobs only the originating TPM can load, so deleting every copy destroys the identity; apg-cng-key-v1 (Windows) names persisted Platform Crypto Provider keys, removed with tpm.key.delete",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "apg:HardwareKeyReference",
      "@type": "apg:Entity",
      "description": "Public apg-pkcs11-key-v1 file binding a P-384 identity to token serial, label, manufacturer, model and two key IDs; holds no secret material",
      "sensitivity": "public"
    },
    {
      "@id": "apg:ToolAllowlist",
      "@type": "apg:Entity",
      "description": "Host-selected APG operation IDs exposed and callable in this MCP session; not a filesystem sandbox",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TrustStore",
      "@type": "apg:Entity",
      "description": "Immutable snapshot of explicitly enrolled public identities and retained verified revocations with optional signed validity windows",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TrustDigest",
      "@type": "apg:Entity",
      "description": "Externally pinned commitment to a canonical trust snapshot: SHA-384 for apg-trust-v3, SHA-256 for legacy v1 and v2; not a signature or freshness proof",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TrustPolicy",
      "@type": "apg:Entity",
      "description": "Explicit snapshot path and expected digest; requires enrollment, rejects retained revocations and enforces validity at host time",
      "sensitivity": "control"
    },
    {
      "@id": "apg:TrustStatus",
      "@type": "apg:Entity",
      "description": "Revocation state in one pinned snapshot; false does not establish global active status",
      "sensitivity": "control"
    },
    {
      "@id": "apg:Revocation",
      "@type": "apg:Entity",
      "description": "A self-signed request to permanently stop using both keys of an identity; no trusted timestamp",
      "sensitivity": "public"
    },
    {
      "@id": "apg:RevocationReason",
      "@type": "apg:Entity",
      "description": "Closed vocabulary: compromised, superseded, retired",
      "sensitivity": "public"
    },
    {
      "@id": "apg:RevocationVerification",
      "@type": "apg:Entity",
      "description": "Authenticated certificate evidence; policy_applied is false and no trust state is changed",
      "sensitivity": "public"
    },
    {
      "@id": "apg:Artifact",
      "@type": "apg:Entity",
      "description": "A versioned native APG JSON file or raw data",
      "sensitivity": "public"
    },
    {
      "@id": "apg:Plaintext",
      "@type": "apg:Entity",
      "description": "Exact binary content; never emitted in control responses",
      "sensitivity": "secret"
    },
    {
      "@id": "apg:Passphrase",
      "@type": "apg:Entity",
      "description": "16..4096 exact file bytes, including any newline",
      "sensitivity": "secret"
    },
    {
      "@id": "apg:PublicKey",
      "@type": "apg:Entity",
      "description": "Independent encryption and signing public keys bound by a fingerprint: X25519 and Ed25519 (apg-public-v1), ML-KEM-768 plus X25519 with Ed25519 plus ML-DSA-65 (apg-public-hybrid-v1), P-384 ECDH and ECDSA (apg-public-p384-v1), or P-384 ECDH with ECDSA P-384 plus ML-DSA-65 (apg-public-p384-mldsa65-v1)",
      "sensitivity": "public"
    },
    {
      "@id": "apg:SecretKey",
      "@type": "apg:Entity",
      "description": "Software identity seeds protected by Argon2id and ChaCha20-Poly1305: 64 bytes (apg-secret-v1) or 160 bytes including the ML-KEM-768 and ML-DSA-65 seeds (apg-secret-hybrid-v1)",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "apg:Fingerprint",
      "@type": "apg:Entity",
      "description": "Hash of a suite-specific domain-separated length-framed pair of public keys: SHA-256 (32 bytes) for apg-public-v1, SHA-384 (48 bytes) for P-384, P-384 plus ML-DSA-65 and hybrid identities",
      "sensitivity": "public"
    },
    {
      "@id": "apg:Envelope",
      "@type": "apg:Entity",
      "description": "Single-recipient authenticated encryption in the recipient's suite; does not identify a sender",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "apg:Signature",
      "@type": "apg:Entity",
      "description": "Detached Ed25519, low-s ECDSA P-384, composite Ed25519 plus ML-DSA-65, or composite ECDSA P-384 plus ML-DSA-65 signature over a framed signer fingerprint and content; both halves of a composite must verify",
      "sensitivity": "public"
    },
    {
      "@id": "apg:Verification",
      "@type": "apg:Entity",
      "description": "Valid signature for an externally pinned key; no external identity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "apg:Digest",
      "@type": "apg:Entity",
      "description": "SHA-256 digest; no authenticity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "apg:Inspection",
      "@type": "apg:Entity",
      "description": "Unauthenticated artifact metadata",
      "sensitivity": "untrusted"
    },
    {
      "@id": "apg:Request",
      "@type": "apg:Entity",
      "description": "Strict tagged operation with named parameters",
      "sensitivity": "control"
    },
    {
      "@id": "apg:Plan",
      "@type": "apg:Entity",
      "description": "Typed request-shape contract; semantic constraints and file authentication are not checked",
      "sensitivity": "control"
    },
    {
      "@id": "apg:CapabilityCatalog",
      "@type": "apg:Entity",
      "description": "Executable operation inventory and runtime limits",
      "sensitivity": "control"
    },
    {
      "@id": "apg:AlgorithmCatalog",
      "@type": "apg:Entity",
      "description": "Upstream IronCrypto ontology; presence does not enable an APG suite",
      "sensitivity": "control"
    },
    {
      "@id": "apg:Schema",
      "@type": "apg:Entity",
      "description": "Generated JSON Schema including static input constraints; cryptographic and relational validation remains at runtime",
      "sensitivity": "control"
    },
    {
      "@id": "apg:Ontology",
      "@type": "apg:Entity",
      "description": "Versioned JSON-LD graph of this implementation",
      "sensitivity": "control"
    },
    {
      "@id": "apg:operation/knowledge",
      "@type": "apg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/knowledge-advisory"
      ],
      "description": "Read the centralized cryptography application knowledgebase and selection ontology",
      "deterministic": true,
      "effects": [],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "knowledge",
      "inputs": [],
      "key_inputs": [],
      "mcp_tool": "apg_knowledge",
      "optional_inputs": [],
      "outputs": [
        "apg:KnowledgeBase"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "knowledge"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "apg:operation/knowledge.search",
      "@type": "apg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/knowledge-advisory"
      ],
      "description": "Find application guidance by keywords or application ID; advisory only, no execution",
      "deterministic": true,
      "effects": [],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "knowledge.search",
      "inputs": [
        "apg:KnowledgeQuery"
      ],
      "key_inputs": [],
      "mcp_tool": "apg_knowledge_search",
      "optional_inputs": [],
      "outputs": [
        "apg:KnowledgeSelection"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "knowledge.search"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "apg:operation/request.validate",
      "@type": "apg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/preflight-only"
      ],
      "description": "Preflight candidate Request JSON without execution, filesystem access or authentication",
      "deterministic": true,
      "effects": [],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "request.validate",
      "inputs": [
        "apg:CandidateRequest"
      ],
      "key_inputs": [],
      "mcp_tool": "apg_request_validate",
      "optional_inputs": [],
      "outputs": [
        "apg:RequestValidation"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "request.validate"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "apg:operation/trust.compare",
      "@type": "apg:Operation",
      "algorithms": [
        "ic:sha2-256",
        "ic:ed25519",
        "ic:ecdsa-p384-sha384",
        "ic:sha2-384",
        "ic:ml-dsa-65"
      ],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/snapshot-policy",
        "apg:constraint/snapshot-reconciliation"
      ],
      "description": "Compare two pinned snapshots without approving or publishing either",
      "deterministic": true,
      "effects": [
        "read_file"
      ],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "trust.compare",
      "inputs": [
        "apg:TrustPolicy"
      ],
      "key_inputs": [],
      "mcp_tool": "apg_trust_compare",
      "optional_inputs": [],
      "outputs": [
        "apg:TrustComparison"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "trust.compare"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "apg:operation/trust.merge",
      "@type": "apg:Operation",
      "algorithms": [
        "ic:sha2-256",
        "ic:ed25519",
        "ic:ecdsa-p384-sha384",
        "ic:sha2-384",
        "ic:ml-dsa-65"
      ],
      "conditional_effects": [],
      "constraints": [
        "apg:constraint/snapshot-policy",
        "apg:constraint/snapshot-reconciliation",
        "apg:constraint/no-clobber"
      ],
      "description": "Reconcile two pinned snapshots, retaining revocations and nested validity restrictions",
      "deterministic": true,
      "effects": [
        "read_file",
        "create_file"
      ],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "trust.merge",
      "inputs": [
        "apg:TrustPolicy"
      ],
      "key_inputs": [],
      "mcp_tool": "apg_trust_merge",
      "optional_inputs": [],
      "outputs": [
        "apg:TrustStore",
        "apg:TrustDigest"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "trust.merge"
      },
      "retry": "Do not retry blindly; inspect the destination after an ambiguous transport failure. Existing outputs are never replaced."
    },
    {
      "@id": "apg:operation/key.validity",
      "@type": "apg:Operation",
      "algorithms": [
        "ic:ed25519",
        "ic:argon2id",
        "ic:chacha20-poly1305",
        "ic:ecdsa-p384-sha384",
        "ic:sha2-384",
        "ic:ml-dsa-65"
      ],
      "conditional_effects": [
        "load the host PKCS#11 module and log in to a token when key is a hardware reference",
        "open the host TPM and load wrapped keys when key is an apg-tpm-key-v1 file",
        "call AWS KMS with host credentials over the network when key is an apg-kms-key-v1 file"
      ],
      "constraints": [
        "apg:constraint/identity-pin",
        "apg:constraint/secret-channel",
        "apg:constraint/no-clobber",
        "apg:constraint/certificate-not-enforcement",
        "apg:constraint/key-provider",
        "apg:constraint/hybrid-post-quantum",
        "apg:constraint/validity-window"
      ],
