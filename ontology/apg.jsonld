      ],
      "id": "openpgp.verify",
      "inputs": [
        "apg:Plaintext",
        "apg:OpenpgpSignature",
        "apg:OpenpgpCertificate",
        "apg:OpenpgpFingerprint"
      ],
      "key_inputs": [],
      "mcp_tool": "apg_openpgp_verify",
      "optional_inputs": [],
      "outputs": [
        "apg:OpenpgpVerification"
      ],
      "request_schema": {
        "command": "apg schema",
        "operation_const": "openpgp.verify"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "apg:constraint/knowledge-advisory",
      "@type": "apg:Constraint",
      "requirement": "Selection is advisory, never execution or authorization. Check support, prerequisites and limitations. External-required applications expose no APG tools. Unknown queries produce no recommendation.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/preflight-only",
      "@type": "apg:Constraint",
      "requirement": "Preflight checks typed request shape, pins, time bounds and cross-field ordering. It never executes candidates or loads files. A successful validation response may contain valid=false. Existing files, authentication, host MCP policy and allowlists remain runtime checks. Candidate limits: 64 nesting levels, 65536 compact JSON bytes, 32 issues.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/snapshot-reconciliation",
      "@type": "apg:Constraint",
      "requirement": "Both snapshots require externally trusted digest pins. Comparison is advisory and additions still require authorization. Merge keeps base order and revocation certificates, imports missing revocations, and selects a signed nested validity window; incomparable windows fail. Publication never updates a current-policy pointer, supplies rollback protection, or establishes ancestry.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/validity-window",
      "@type": "apg:Constraint",
      "requirement": "Validity uses Unix seconds and a half-open window. Import verified certificates with trust.validity; windows can only narrow. Governed operations check host time once and report policy_checked_at. trust.evaluate is advisory. No expiry is inferred for identities without a certificate. Host clock integrity and current snapshot pins are external responsibilities.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/mcp-host-boundary",
      "@type": "apg:Constraint",
      "requirement": "MCP startup configuration is host-controlled. Allowlist decisions are enforced at dispatch. Pinned policy applies only to encrypt, sign and verify. --key-custody hardware refuses every software private-key operation. The process still has its OS identity's filesystem and token access; the host must authorize paths, PIN files and secret access.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/snapshot-policy",
      "@type": "apg:Constraint",
      "requirement": "Supply policy to enforce enrollment, revocation and imported validity windows. Missing or invalid requested stores fail closed. Retain the latest digest externally; old correctly pinned snapshots remain usable. Policy is checked once per operation; it is not a global authorization service.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/old-copies-remain",
      "@type": "apg:Constraint",
      "requirement": "Rewrapping changes only passphrase protection. Existing copies remain usable with the old passphrase; it does not recover a compromised identity.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/certificate-not-enforcement",
      "@type": "apg:Constraint",
      "requirement": "Certificate verification alone applies no policy. Import certificates with trust.revoke or trust.validity, distribute the new snapshot digest, and supply policy to encryption, signing or verification to enforce it.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/secret-channel",
      "@type": "apg:Constraint",
      "requirement": "Supply passphrases via a protected file; never as request values or argv secrets. Exact bytes are used without trimming.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/identity-pin",
      "@type": "apg:Constraint",
      "requirement": "Obtain the expected fingerprint through a trusted channel. A fingerprint copied from an untrusted key file supplies no identity assurance.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/no-clobber",
      "@type": "apg:Constraint",
      "requirement": "Outputs use create-new publication; existing destinations are never replaced.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/authenticate-before-release",
      "@type": "apg:Constraint",
      "requirement": "Decryption authenticates the entire envelope before writing any output.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/no-sender-authentication",
      "@type": "apg:Constraint",
      "requirement": "Encryption does not authenticate a sender. Use detached signatures when sender authentication is required.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/exact-bytes",
      "@type": "apg:Constraint",
      "requirement": "Verification covers exact input bytes; no text normalization occurs.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/untrusted-metadata",
      "@type": "apg:Constraint",
      "requirement": "Inspection rejects malformed structure and reports structurally_valid=true only on success. It is not verification and always returns authenticated=false; standalone signatures, certificates and encrypted content are not authenticated. Trust snapshots additionally check internal certificate consistency, without an external digest pin.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/size-bound",
      "@type": "apg:Constraint",
      "requirement": "Inputs are bounded; encryption plaintext is capped to fit hex-encoded envelopes within the file limit.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/host-provider",
      "@type": "apg:Constraint",
      "requirement": "The PKCS#11 module loads only from the absolute path in the host's APG_PKCS11_MODULE; requests can never name a module. Loading runs vendor code inside the APG process. Builds without the pkcs11 feature fail with provider_unavailable.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/kms-provider",
      "@type": "apg:Constraint",
      "requirement": "AWS KMS is reached with the host's AWS credentials (environment, web identity through STS, static or IAM Identity Center profile, ECS/EKS container credentials or EC2 IMDSv2 instance profile) over TLS from rustls with IronCrypto; requests can never supply credentials or endpoints. APG_KMS_FIPS=1 selects FIPS endpoints; APG_KMS_ENDPOINT is for local test services. Keys are never created by APG: provision one ECC_NIST_P384 KEY_AGREEMENT key and one ECC_NIST_P384 SIGN_VERIFY key, and optionally one ML_DSA_65 SIGN_VERIFY key for composite post-quantum signatures, with infrastructure tooling, and grant only kms:GetPublicKey, kms:Sign and kms:DeriveSharedSecret. With the ML-DSA key every signature, revocation and validity certificate needs both ECDSA P-384 and ML-DSA-65 to verify; APG sends KMS the FIPS 204 message representative (MessageType EXTERNAL_MU), so the result is a standard pure ML-DSA signature with APG's context. Encryption stays P-384 ECDH: KMS offers no ML-KEM, so such identities are not protected against later quantum decryption. Every private-key operation is a billable, logged KMS call and fails if the network or AWS is unavailable.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/stream-envelope",
      "@type": "apg:Constraint",
      "requirement": "apg-stream-v1 encrypts any size in 64 KiB chunks under a random content key wrapped as an apg-envelope-v1 for each of 1..64 recipients (any identity suite or key provider). Each chunk's nonce encodes its index and a final-chunk flag, and its associated data commits to the whole header, so reordering, truncation, extension and adding or removing recipients are detected. Content uses AES-256-GCM when every recipient is a P-384 identity, otherwise ChaCha20-Poly1305. Decryption releases plaintext only after the final chunk authenticates. Every recipient can decrypt and could re-encrypt different content to the others: streams carry no sender authentication, so sign them when origin matters.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/tpm-attestation",
      "@type": "apg:Constraint",
      "requirement": "TPM attestation proves that an apg-tpm-key-v1 identity's two keys are resident, non-exportable (fixedTPM, fixedParent) keys generated inside (sensitiveDataOrigin) a TPM whose RSA-2048 endorsement key chains to a verifier-chosen manufacturer root. A restricted attestation key, derived from the TPM's endorsement seed, certifies both keys with TPM2_Certify bound to the identity; TPM2_ActivateCredential then proves that attestation key shares the TPM with the certified EK. It proves nothing about the host, its software or who controls the PIN, and certificates are not checked for revocation. It is a point-in-time statement. apg-cng-key-v1 keys cannot be attested; Windows' built-in key attestation claim was rejected because it signs with SHA-1 by an OS-internal key not bound to the EK.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/verifier-secret",
      "@type": "apg:Constraint",
      "requirement": "tpm.attestation.challenge writes the credential to secret_output. Keep that file private to the verifier, never send it to the prover, and use each challenge once; verification succeeds only if the prover's TPM released the same credential.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/openpgp-boundary",
      "@type": "apg:Constraint",
      "requirement": "OpenPGP operations use rPGP, not IronCrypto, and need a build with the openpgp feature (otherwise provider_unavailable). They never read native APG artifacts, and native operations never read OpenPGP data. APG trust snapshots do not apply; an MCP host with a pinned trust policy exposes OpenPGP tools only when --allow names them. OpenPGP secret keys are software keys, so host key-custody policies other than any refuse key generation, decryption and signing.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/openpgp-pin",
      "@type": "apg:Constraint",
      "requirement": "Each certificate must match an independently trusted fingerprint in expected_openpgp_fingerprint (40 hex, either case). A certificate file must hold exactly one v4 certificate.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/openpgp-certificate-policy",
      "@type": "apg:Constraint",
      "requirement": "APG evaluates certificates itself at host time (verification: at the signature's creation time, plus revocation now). A key is usable only with a valid unexpired binding self-signature using SHA-256 or stronger and matching key flags; signing subkeys need a valid back signature. Any valid revocation by the primary key revokes, whatever its reason. RSA below 2048 bits, DSA, ElGamal, SHA-1 and MD5 are refused. Third-party certifications and designated revokers are ignored. Encryption uses every usable encryption key of each certificate.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/openpgp-user-id",
      "@type": "apg:Constraint",
      "requirement": "User IDs are self-asserted labels. APG reports only those with a valid self-certification and never treats them as identity proof; pin fingerprints instead.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/openpgp-embedded-signatures",
      "@type": "apg:Constraint",
      "requirement": "Signatures inside a decrypted message are reported by signed=true but never verified (signatures_verified=false); exchange detached signatures and use openpgp.verify. Sender identity is otherwise unauthenticated.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/openpgp-size-bound",
      "@type": "apg:Constraint",
      "requirement": "Plaintext is limited to 16 MiB and messages to the file limit. One compression layer is accepted and decompressed output is bounded; bzip2 is unsupported. Legacy unprotected (SED) messages are refused, and plaintext is released only after the integrity check.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/irreversible-deletion",
      "@type": "apg:Constraint",
      "requirement": "Deleting TPM keys destroys the identity permanently: nothing encrypted to it can be decrypted and it can never sign again. APG checks the PIN and the pinned identity first. Publish a revocation beforehand if others trust the identity.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/tpm-provider",
      "@type": "apg:Constraint",
      "requirement": "On Windows, tpm builds use the Microsoft Platform Crypto Provider through CNG: keys persist in the user's TPM key store, are non-exportable, and are authorized by a PIN-derived usage authorization under the TPM's dictionary-attack lockout. On Linux, the TPM connection comes only from the host's APG_TPM_TCTI (for example device:/dev/tpmrm0); requests can never name it. Linux builds need the tpm2-tss libraries. The owner hierarchy must have empty authorization. Keys are fixedTPM, fixedParent blobs under a storage root the TPM re-derives from a fixed template; back up the key file, since it is the only copy. Signing and ECDH authorize through HMAC sessions without sending the PIN-derived authorization; key creation sends it parameter-encrypted. Sessions are salted with the storage root key, which protects against passive TPM-bus observers but not an active interposer. Guessing is limited by the TPM dictionary-attack lockout.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/pin-channel",
      "@type": "apg:Constraint",
      "requirement": "Supply token PINs via a protected file, never as request values or argv. Exact bytes are used. Failed PIN attempts consume token retry counters: never retry authentication_failed automatically; pin_locked requires token administration.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/non-exportable-key",
      "@type": "apg:Constraint",
      "requirement": "Private keys are created and accepted only as P-384 objects with CKA_SENSITIVE true and CKA_EXTRACTABLE false. APG never requests private key values. Tokens supporting CKD_SHA384_KDF and CKM_AES_GCM decrypt entirely in-token; others release one per-envelope ECDH shared secret into process memory for the X9.63 KDF. Long-term keys stay on the token.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/possession-check",
      "@type": "apg:Constraint",
      "requirement": "Before writing a reference, the token must produce a self-verifying signature and an ECDH result equal to software ECDH with a fresh ephemeral key.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/token-objects-persist",
      "@type": "apg:Constraint",
      "requirement": "Generated keys are persistent token objects. Failed post-generation checks delete them best-effort. If the reference cannot be written, the error reports both key IDs for hardware.key.bind or manual deletion.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/no-attestation",
      "@type": "apg:Constraint",
      "requirement": "Protection flags are attributes the token reports about itself, not vendor attestation. Public artifacts do not reveal custody; counterparties cannot distinguish hardware from software keys. For TPM identities, tpm.attest and the tpm.attestation operations produce verifiable attestation.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/key-provider",
      "@type": "apg:Constraint",
      "requirement": "key accepts a software secret (passphrase_file holds its passphrase), an apg-pkcs11-key-v1 or apg-tpm-key-v1 key (passphrase_file holds the PIN), or an apg-kms-key-v1 key (omit passphrase_file; host AWS credentials are used). Device and service keys must match the pinned identity exactly, and every signature is self-verified. Hosts may require non-exportable or hardware custody and refuse other keys with policy_mismatch.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/hybrid-post-quantum",
      "@type": "apg:Constraint",
      "requirement": "Hybrid identities (key.generate identity apg-public-hybrid-v1) receive envelopes keyed by HKDF over both an ML-KEM-768 and an X25519 shared secret, binding both ciphertexts, and sign with composite ed25519-mldsa65 signatures that verify only if both halves verify over the same framed message. Confidentiality and authenticity hold while either component of each pair is unbroken. Fingerprints use SHA-384; snapshot digests use SHA-256. Suites follow the identity; there is no negotiation, downgrade or stripping to Ed25519.",
      "severity": "critical"
    },
    {
      "@id": "apg:constraint/software-key-only",
      "@type": "apg:Constraint",
      "requirement": "Applies only to apg-secret-v1 software keys. Refused with policy_mismatch when the host requires hardware key custody.",
      "severity": "critical"
    },
    {
      "@id": "apg:error/merge_conflict",
      "@type": "apg:Error",
      "code": "merge_conflict",
      "exit_code": 3,
      "recovery": "Obtain a signed validity window contained in both branch windows and import it into a branch before merging. Disjoint windows require a new identity.",
      "retryable": false
    },
    {
      "@id": "apg:error/key_expired",
      "@type": "apg:Error",
      "code": "key_expired",
      "exit_code": 3,
      "recovery": "Use a new trusted identity; do not backdate the clock or roll back policy.",
      "retryable": false
    },
    {
      "@id": "apg:error/key_not_yet_valid",
      "@type": "apg:Error",
      "code": "key_not_yet_valid",
      "exit_code": 3,
      "recovery": "Wait for the validity window; verify host clock integrity.",
      "retryable": false
    },
    {
      "@id": "apg:error/clock_unavailable",
      "@type": "apg:Error",
      "code": "clock_unavailable",
      "exit_code": 5,
      "recovery": "Restore a valid host clock.",
      "retryable": false
    },
    {
      "@id": "apg:error/key_not_trusted",
      "@type": "apg:Error",
      "code": "key_not_trusted",
      "exit_code": 3,
      "recovery": "Enroll the independently pinned identity into the authoritative snapshot; do not bypass the requested policy.",
      "retryable": false
    },
    {
      "@id": "apg:error/key_revoked",
      "@type": "apg:Error",
      "code": "key_revoked",
      "exit_code": 3,
      "recovery": "Use a different trusted identity; do not delete revocation records or roll back the snapshot.",
      "retryable": false
    },
    {
      "@id": "apg:error/policy_mismatch",
      "@type": "apg:Error",
      "code": "policy_mismatch",
      "exit_code": 3,
      "recovery": "Obtain the authoritative snapshot matching the externally retained digest; never adopt a digest from untrusted storage automatically.",
      "retryable": false
    },
    {
      "@id": "apg:error/invalid_request",
      "@type": "apg:Error",
      "code": "invalid_request",
      "exit_code": 2,
      "recovery": "Consult schema; correct fields or protocol.",
      "retryable": false
    },
    {
      "@id": "apg:error/invalid_format",
      "@type": "apg:Error",
      "code": "invalid_format",
      "exit_code": 2,
      "recovery": "Use supported versioned artifacts and canonical lowercase fixed-length hex fields.",
      "retryable": false
    },
    {
      "@id": "apg:error/limit_exceeded",
      "@type": "apg:Error",
      "code": "limit_exceeded",
      "exit_code": 2,
      "recovery": "Reduce input size; chunking protocol is not implemented.",
      "retryable": false
    },
    {
      "@id": "apg:error/authentication_failed",
      "@type": "apg:Error",
      "code": "authentication_failed",
      "exit_code": 3,
      "recovery": "Check credentials and provenance; never bypass authentication.",
      "retryable": false
    },
    {
      "@id": "apg:error/identity_mismatch",
      "@type": "apg:Error",
      "code": "identity_mismatch",
      "exit_code": 3,
      "recovery": "Resolve the identity via a trusted channel; do not automatically replace the pin.",
      "retryable": false
    },
    {
      "@id": "apg:error/io_error",
      "@type": "apg:Error",
      "code": "io_error",
      "exit_code": 4,
      "recovery": "Check file availability and permissions.",
      "retryable": false
    },
    {
      "@id": "apg:error/already_exists",
      "@type": "apg:Error",
      "code": "already_exists",
      "exit_code": 4,
      "recovery": "Inspect the existing output or choose a new path.",
      "retryable": false
    },
    {
      "@id": "apg:error/entropy_unavailable",
      "@type": "apg:Error",
      "code": "entropy_unavailable",
      "exit_code": 5,
      "recovery": "Restore OS randomness; never supply a predictable fallback.",
      "retryable": false
    },
    {
      "@id": "apg:error/provider_unavailable",
      "@type": "apg:Error",
      "code": "provider_unavailable",
      "exit_code": 5,
      "recovery": "The host must use a pkcs11 build with APG_PKCS11_MODULE set to an absolute module path, a Linux tpm build with APG_TPM_TCTI set, or a kms build with AWS credentials; callers cannot supply any of these.",
      "retryable": false
    },
    {
      "@id": "apg:error/hardware_not_found",
      "@type": "apg:Error",
      "code": "hardware_not_found",
      "exit_code": 4,
      "recovery": "Present the correct token and confirm its serial and key IDs with hardware.tokens and token tooling.",
      "retryable": false
    },
    {
      "@id": "apg:error/mechanism_unsupported",
      "@type": "apg:Error",
      "code": "mechanism_unsupported",
      "exit_code": 5,
      "recovery": "Use a token supporting P-384 with CKM_EC_KEY_PAIR_GEN, CKM_ECDSA and CKM_ECDH1_DERIVE; APG never substitutes another curve.",
      "retryable": false
    },
    {
      "@id": "apg:error/provider_error",
      "@type": "apg:Error",
      "code": "provider_error",
      "exit_code": 5,
      "recovery": "Inspect token and module state; do not retry key creation blindly.",
      "retryable": false
    },
    {
      "@id": "apg:error/pin_locked",
      "@type": "apg:Error",
      "code": "pin_locked",
      "exit_code": 3,
      "recovery": "Token administration must unblock or reset the PIN; never retry.",
      "retryable": false
    },
    {
      "@id": "apg:error/rate_limited",
      "@type": "apg:Error",
      "code": "rate_limited",
      "exit_code": 5,
      "recovery": "Wait until the MCP session's current 60-second window ends before retrying; no operation was executed.",
      "retryable": true
    },
