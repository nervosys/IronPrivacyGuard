          {
            "@id": "ipg:operation/trust.validity"
          },
          {
            "@id": "ipg:operation/trust.evaluate"
          }
        ]
      }
    },
    {
      "@id": "ipg:workflow/enroll-trust",
      "@type": "ipg:Workflow",
      "steps": {
        "@list": [
          {
            "@id": "ipg:operation/trust.init"
          },
          {
            "@id": "ipg:operation/trust.add"
          },
          {
            "@id": "ipg:operation/trust.status"
          }
        ]
      }
    },
    {
      "@id": "ipg:workflow/enforce-revocation",
