          {
            "@id": "ipg:operation/sign"
          },
          {
            "@id": "ipg:operation/verify"
          }
        ]
      }
    },
    {
      "@id": "ipg:workflow/agent-bootstrap",
      "@type": "ipg:Workflow",
      "steps": {
        "@list": [
          {
            "@id": "ipg:operation/discover"
          },
          {
            "@id": "ipg:operation/schema"
