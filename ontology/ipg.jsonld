            "@id": "ipg:operation/plan"
          }
        ]
      }
    },
    {
      "@id": "ic:x25519",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Ephemeral sender key agreement with the recipient public key inside the native envelope suite",
      "label": "X25519",
      "limitations": [
        "Not encryption on its own",
        "Does not authenticate the sender",
        "Not post-quantum"
      ],
      "role": "Key agreement",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc7748"
      ]
    },
    {
      "@id": "ic:hkdf-sha2-256",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Derive the envelope encryption key from the X25519 shared secret with protocol context",
      "label": "HKDF-SHA-256",
      "limitations": [
        "Not a password-hardening function",
        "No standalone IPG derivation command"
      ],
      "role": "Key derivation from keying material",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc5869"
      ]
    },
    {
      "@id": "ic:chacha20-poly1305",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Protect envelope plaintext and wrapped private seeds; authenticate before releasing plaintext",
      "label": "ChaCha20-Poly1305",
      "limitations": [
        "Nonce reuse under the same key is unsafe",
        "Ciphertext authentication is not proof of sender identity"
      ],
      "role": "Authenticated encryption with associated data",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8439"
      ]
    },
    {
      "@id": "ic:ed25519",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Domain-separated content signatures and signed identity lifecycle certificates",
      "label": "Ed25519",
      "limitations": [
        "No confidentiality",
        "Key identity needs an independent trust binding",
        "Not post-quantum"
      ],
      "role": "Digital signature",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8032"
      ]
    },
    {
      "@id": "ic:argon2id",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Derive private-key wrapping keys using the fixed IPG v1 profile: 65536 KiB memory, 3 iterations, 4 lanes",
      "label": "Argon2id",
      "limitations": [
        "No IPG password-verifier API",
        "IPG profile is a protocol choice, not a universal password policy"
      ],
      "role": "Memory-hard password-based derivation",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106"
      ]
    },
    {
      "@id": "ic:sha2-256",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "File digests, ipg-public-v1 fingerprints and legacy v1/v2 trust snapshot digests",
      "label": "SHA-256",
      "limitations": [
        "Unkeyed hashing does not prove origin",
        "Fast hashing is not password hardening"
      ],
      "role": "Cryptographic digest",
      "sources": []
    },
    {
      "@id": "ic:ecdh-p384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Ephemeral sender key agreement with a P-384 identity; tokens run CKM_ECDH1_DERIVE, preferably with the X9.63 KDF so the shared secret never leaves them",
      "label": "ECDH P-384",
      "limitations": [
        "Not encryption on its own",
        "Does not authenticate the sender",
        "Not post-quantum",
        "Points must be validated uncompressed curve points"
      ],
      "role": "Key agreement",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-56Ar3"
      ]
    },
    {
      "@id": "ic:aes-256-gcm",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Protect P-384 envelope plaintext; authenticate before releasing plaintext",
      "label": "AES-256-GCM",
      "limitations": [
        "Nonce reuse under the same key is catastrophic",
        "Ciphertext authentication is not proof of sender identity"
      ],
      "role": "Authenticated encryption with associated data",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ]
    },
    {
      "@id": "ic:ecdsa-p384-sha384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Hardware identity signatures, certificates and possession checks; tokens sign the SHA-384 digest with CKM_ECDSA and IPG canonicalizes to low-s",
      "label": "ECDSA P-384 with SHA-384",
      "limitations": [
        "Randomized signatures differ per run",
        "Signatures are malleable unless low-s is enforced, which IPG does",
        "Not post-quantum"
      ],
      "role": "Digital signature",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.186-5"
      ]
    },
    {
      "@id": "ic:sha2-384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "P-384 and hybrid identity fingerprints, ipg-trust-v3 snapshot digests, the message digest for ECDSA P-384 signatures, and the hash inside the P-384 envelope's ANSI X9.63 KDF (PKCS#11 CKD_SHA384_KDF) and its SharedInfo commitment",
      "label": "SHA-384",
      "limitations": [
        "No authenticity on its own",
        "Not a password-hardening function",
        "No standalone IPG sha2-384 digest command"
      ],
      "role": "Cryptographic hash",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.180-4"
      ]
    },
    {
      "@id": "ic:ml-kem-768",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Encapsulates a second shared secret to hybrid identities; combined with X25519 by HKDF so either component alone protects the envelope",
      "label": "ML-KEM-768",
      "limitations": [
        "Encapsulation only, not encryption or authentication",
        "Marked experimental in IronCrypto; interoperability checked against PyCA and OpenSSL",
        "Not used for signatures"
      ],
      "role": "Post-quantum key encapsulation",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.203"
      ]
    },
    {
      "@id": "ic:ml-dsa-65",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Second half of composite ed25519-mldsa65 signatures and certificates for hybrid identities; hedged signing with a fixed IPG context string",
      "label": "ML-DSA-65",
      "limitations": [
        "Used only in composite with Ed25519",
        "Marked experimental in IronCrypto; interoperability checked against PyCA and OpenSSL",
        "Large signatures (3309 bytes)"
      ],
      "role": "Post-quantum digital signature",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.204"
      ]
    },
    {
      "@id": "ipg:application/confidential-file-transfer",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality",
        "ipg:goal/ciphertext-integrity"
      ],
      "guidance": "The envelope suite follows the recipient identity: X25519/ChaCha20-Poly1305 for ipg-public-v1, P-384/AES-256-GCM for ipg-public-p384-v1. Inspect discover limits before transferring data.",
      "id": "confidential-file-transfer",
      "keywords": [
        "encryption",
        "decryption",
        "confidentiality",
        "backup",
        "at rest",
        "X25519",
        "HKDF",
        "ChaCha20 Poly1305",
        "P-384",
        "AES-GCM"
      ],
      "label": "Encrypt and decrypt a file for one recipient",
      "limitations": [
        "One recipient and native IPG format only; bounded in-memory files",
        "Encryption does not authenticate the sender",
        "No forward secrecy against later recipient private-key compromise",
        "Decryption remains available for recovery without trust policy enforcement"
      ],
      "prerequisites": [
        "Recipient public identity and independently trusted fingerprint",
        "Recipient secret key and passphrase file, or hardware key reference and PIN file, for decryption",
        "Supply a pinned trust policy to encrypt when revocation and expiry must be enforced"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8439",
        "https://www.rfc-editor.org/rfc/rfc7748",
        "https://www.rfc-editor.org/rfc/rfc5869",
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/encrypt",
        "ipg:operation/decrypt"
      ]
    },
    {
      "@id": "ipg:application/authenticate-file",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity",
        "ipg:goal/content-integrity"
      ],
      "guidance": "Verify against the expected signer and exact original bytes before consuming content. Use stream.sign and stream.verify beyond the in-memory limit; their separate native format signs a SHA-384 commitment and byte count with bounded memory.",
      "id": "authenticate-file",
      "keywords": [
        "signature",
        "signing",
        "authenticity",
        "artifact",
        "release",
        "Ed25519",
        "ECDSA"
      ],
      "label": "Sign and verify exact file bytes",
      "limitations": [
        "Native detached IPG signatures; no OpenPGP or platform code-signing compatibility",
        "No confidentiality, trusted timestamp, replay prevention or automatic authorization"
      ],
      "prerequisites": [
        "Signer secret key and passphrase, or hardware key reference and PIN file, for signing",
        "Public signer identity and independently trusted fingerprint for verification",
        "Supply a pinned policy for revocation and expiry enforcement"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8032",
        "https://doi.org/10.6028/NIST.FIPS.186-5"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/sign",
        "ipg:operation/verify",
        "ipg:operation/stream.sign",
        "ipg:operation/stream.verify"
      ]
    },
    {
      "@id": "ipg:application/file-digest",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-identification"
      ],
      "guidance": "Compare digests for byte identity; use sign and verify when signer authentication is needed.",
      "id": "file-digest",
      "keywords": [
        "hash",
        "checksum",
        "fingerprint",
        "deduplication",
        "sha256"
      ],
      "label": "Compute a SHA-256 file digest",
      "limitations": [
        "An unkeyed digest does not authenticate a sender",
        "Not a password storage or password derivation interface"
      ],
      "prerequisites": [
        "An independently authenticated expected digest if using the result to detect malicious substitution"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/hash"
      ]
    },
    {
      "@id": "ipg:application/protect-private-identity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/secret-protection"
      ],
      "guidance": "IPG internally derives a wrapping key with Argon2id and encrypts private seeds; no raw KDF endpoint is exposed.",
      "id": "protect-private-identity",
      "keywords": [
        "key generation",
        "private key",
        "secret key",
        "password",
        "rewrap",
        "Argon2id"
      ],
      "label": "Create an identity and change its protective passphrase",
      "limitations": [
        "Rewrapping does not rotate the identity or invalidate old copies",
        "Host filesystem permissions and secret-file cleanup remain caller responsibilities"
      ],
      "prerequisites": [
        "Access-controlled passphrase file of 16..4096 bytes",
        "New destinations; IPG never overwrites files",
        "Expected identity fingerprint when rewrapping"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106",
        "https://www.rfc-editor.org/rfc/rfc8439"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/key.public",
        "ipg:operation/key.rewrap"
      ]
    },
    {
      "@id": "ipg:application/manage-trust",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Publish immutable snapshots and explicitly supply the approved pin to governed operations or MCP host configuration.",
      "id": "manage-trust",
      "keywords": [
        "trust",
        "policy",
        "enrollment",
        "allowlist",
        "compare",
        "merge"
      ],
      "label": "Enroll identities and reconcile trust snapshots",
      "limitations": [
        "Comparison and merge do not approve policy",
        "No automatic revocation distribution or rollback protection; retain latest digest externally"
      ],
      "prerequisites": [
        "Independently trusted identity fingerprints",
        "Externally pinned snapshot digests and explicit approval of newly produced snapshots"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/trust.init",
        "ipg:operation/trust.add",
        "ipg:operation/trust.status",
        "ipg:operation/trust.compare",
        "ipg:operation/trust.merge"
      ]
    },
    {
      "@id": "ipg:application/revoke-identity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Import the authenticated certificate into a new snapshot, then distribute and explicitly adopt its digest.",
      "id": "revoke-identity",
      "keywords": [
        "revocation",
        "compromise",
        "retire",
        "incident"
      ],
      "label": "Revoke an identity and enforce the revocation",
      "limitations": [
        "Certificate creation or verification alone does not enforce revocation",
        "Existing ciphertext and signatures are not erased"
      ],
      "prerequisites": [
        "Identity private key and passphrase to self-revoke",
        "Pinned public identity and trust snapshot to import the certificate"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.revoke",
        "ipg:operation/revocation.verify",
        "ipg:operation/trust.revoke",
        "ipg:operation/trust.status"
      ]
    },
    {
      "@id": "ipg:application/identity-validity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Issue a signed window, import it into a snapshot, and apply that policy to encrypt, sign and verify.",
      "id": "identity-validity",
      "keywords": [
        "expiry",
        "expiration",
        "time",
        "validity",
        "schedule"
      ],
      "label": "Constrain an identity to a signed validity window",
      "limitations": [
        "trust.evaluate is advisory; caller-selected times never authorize execution",
        "Enforcement uses the host clock",
        "Validity imports can narrow existing windows only"
      ],
      "prerequisites": [
        "Signer secret key and passphrase",
        "Unix seconds with not_before strictly less than not_after",
        "Pinned policy adopted by governed operations"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.validity",
        "ipg:operation/validity.verify",
        "ipg:operation/trust.validity",
        "ipg:operation/trust.evaluate"
      ]
    },
    {
      "@id": "ipg:application/inspect-artifact",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/structural-validation"
      ],
      "guidance": "Use inspect to route an artifact, then explicitly invoke the appropriate authentication operation.",
      "id": "inspect-artifact",
      "keywords": [
        "inspect",
        "format",
        "metadata",
        "parse"
      ],
      "label": "Identify a native artifact and validate its structure",
      "limitations": [
        "Inspection does not authenticate the artifact or trust embedded metadata"
      ],
      "prerequisites": [
        "Bounded native IPG artifact file"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/openpgp-interoperability",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/protocol-interoperability"
      ],
      "guidance": "Import a pinned supported transferable secret key with openpgp.key.import and a new IPG wrapping passphrase, or generate an OpenPGP key with openpgp.key.generate (algorithm p384 for CNSA-aligned deployments), export a pinned protected private-key backup with openpgp.key.export using a new passphrase file, share the public certificate from openpgp.cert.export, and review correspondents' certificates with openpgp.cert.inspect before pinning their fingerprints. openpgp.encrypt accepts up to 32 recipients; decrypt and sign with the IPG-held key; verify detached signatures with openpgp.verify or publish authenticated embedded signed content with openpgp.message.verify.",
      "id": "openpgp-interoperability",
      "keywords": [
        "pgp",
        "gpg",
        "openpgp",
        "import",
        "email",
        "compatibility"
      ],
      "label": "Exchange OpenPGP messages or GPG keys",
      "limitations": [
        "openpgp-native adds no dependencies and uses existing IronCrypto primitives for Ed25519/X25519 and P-384; P-384 signatures require SHA-384 and messages require AES-256. openpgp selects broader rPGP compatibility. Neither backend has had independent review",
        "v4 and v6 keys; IPG generates Ed25519 or P-384 keys and exports only passphrase-protected secret keys; imports support only one Ed25519/Curve25519 or P-384 signing primary and one encryption subkey with bounded protection parameters",
        "openpgp.decrypt does not verify embedded signatures; use openpgp.message.verify, which requires one document signature and refuses multiple or nested signatures",
        "No web of trust, keyservers or designated revokers; certificates are pinned by fingerprint and IPG trust snapshots do not apply",
        "Certificates using SHA-1 self-signatures, RSA below 2048 bits, DSA or ElGamal are rejected",
        "IPG native envelopes, signatures and keys are never OpenPGP packets"
      ],
      "prerequisites": [
        "An ipg build with openpgp-native (native curve profile) or openpgp (broader rPGP compatibility)",
        "Each correspondent's OpenPGP certificate and its independently trusted fingerprint (v4 40 hex or v6 64 hex)",
        "An MCP host that pins a trust policy must name the openpgp operations in --allow"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9580",
        "https://github.com/rpgp/rpgp"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/openpgp.key.generate",
        "ipg:operation/openpgp.key.import",
        "ipg:operation/openpgp.key.export",
        "ipg:operation/openpgp.cert.export",
        "ipg:operation/openpgp.cert.inspect",
        "ipg:operation/openpgp.encrypt",
        "ipg:operation/openpgp.decrypt",
        "ipg:operation/openpgp.sign",
        "ipg:operation/openpgp.verify",
        "ipg:operation/openpgp.message.verify"
      ]
    },
    {
      "@id": "ipg:application/secure-network-channel",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/channel-security"
      ],
      "guidance": "Use a complete transport protocol implementation; do not assemble a channel from IPG file commands.",
      "id": "secure-network-channel",
      "keywords": [
        "tls",
        "https",
        "network",
        "transport",
        "channel",
        "session"
      ],
      "label": "Secure a live client-server connection",
      "limitations": [
        "IPG file encryption is not a TLS handshake or record protocol"
      ],
      "prerequisites": [
        "A separately evaluated TLS stack and peer authentication policy"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8446"
      ],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "ipg:application/password-verifier-storage",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/password-verification"
      ],
      "guidance": "Use a dedicated salted password verifier API; do not use IPG hash or treat key wrapping as login verification.",
      "id": "password-verifier-storage",
      "keywords": [
        "password hashing",
        "password database",
        "login",
        "credential",
        "Argon2id"
      ],
      "label": "Store and verify user login passwords",
      "limitations": [
        "IPG uses Argon2id internally but exposes no password verifier interface",
        "IPG hash is a fast file digest, not password hashing"
      ],
      "prerequisites": [
        "A password hashing and verification implementation with application-specific resource policy"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106"
      ],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "ipg:application/multi-recipient-encryption",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality"
      ],
      "guidance": "Use stream.encrypt with a recipients list of {public, expected_fingerprint} objects; each recipient decrypts with stream.decrypt and its own key file. Streams handle files of any size in 64 KiB authenticated chunks and release plaintext only after the last chunk verifies. openpgp.encrypt covers multi-recipient OpenPGP messages.",
      "id": "multi-recipient-encryption",
      "keywords": [
        "group",
        "multi recipient",
        "many recipients",
        "shared envelope",
        "streaming",
        "chunked"
      ],
      "label": "Encrypt one shared envelope for multiple recipients",
      "limitations": [
        "No sender authentication: any recipient could re-encrypt other content to the others; sign streams when origin matters",
        "Streams are binary files; ipg-envelope-v1 (encrypt) stays single-recipient JSON",
        "Post-quantum confidentiality holds only for hybrid recipients; the stream is only as strong as each recipient's wrap for that recipient"
      ],
      "prerequisites": [
        "Each recipient's public identity and independently trusted fingerprint (1..64 recipients, any suite)"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/stream.encrypt",
        "ipg:operation/stream.decrypt"
      ]
    },
    {
      "@id": "ipg:application/post-quantum-protection",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/post-quantum-security",
        "ipg:goal/confidentiality"
      ],
      "guidance": "Create a hybrid identity with ipg key generate --identity ipg-public-hybrid-v1. Encryption to that identity then always uses the hybrid envelope suite; there is no negotiation or fallback.",
      "id": "post-quantum-protection",
      "keywords": [
        "post quantum",
        "pqc",
        "quantum resistant",
        "harvest now decrypt later",
        "ml kem",
        "kyber",
        "hybrid",
        "encryption"
      ],
      "label": "Hybrid post-quantum encryption against future quantum attacks",
      "limitations": [
        "Fingerprints and trust-snapshot digests use SHA-384; signatures are composite Ed25519 plus ML-DSA-65 (see quantum-resistant-signing)",
        "Envelopes stay secure only while ML-KEM-768 or X25519 is unbroken; the combination has not had independent review",
        "IronCrypto's ML-KEM is marked experimental upstream; IPG checks it against PyCA and OpenSSL only",
        "Software secret keys only; hardware identities have no post-quantum suite"
      ],
      "prerequisites": [
        "Generate the recipient with key.generate identity ipg-public-hybrid-v1",
        "Recipient hybrid public identity and independently trusted fingerprint"
      ],
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.203",
        "https://www.rfc-editor.org/rfc/rfc7748",
        "https://www.rfc-editor.org/rfc/rfc5869"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/key.public",
        "ipg:operation/encrypt",
        "ipg:operation/decrypt"
      ]
    },
    {
      "@id": "ipg:application/quantum-resistant-signing",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/quantum-resistant-authenticity"
      ],
      "guidance": "Sign with a hybrid identity, or bind AWS KMS keys with mldsa_signing_key_arn for KMS custody; every signature, revocation and validity certificate then requires both the classical and the ML-DSA-65 signature to verify, so it stays unforgeable while either holds.",
      "id": "quantum-resistant-signing",
      "keywords": [
        "pq signing",
        "quantum resistant signing",
        "ml dsa",
        "dilithium",
        "composite signing"
      ],
      "label": "Require quantum-resistant signing",
      "limitations": [
        "Composite ed25519-mldsa65 (software) or ecdsa-p384-mldsa65 (AWS KMS) only; no SLH-DSA or standalone ML-DSA",
        "PKCS#11 and TPM identities sign with ECDSA P-384 only",
        "KMS post-quantum identities keep P-384 encryption, since KMS has no ML-KEM",
        "IronCrypto's ML-DSA is marked experimental upstream; IPG checks it against PyCA and OpenSSL",
        "Signatures are about 3.4 KB and not interoperable with other composite-signature formats"
      ],
      "prerequisites": [
        "A hybrid identity from key.generate identity ipg-public-hybrid-v1, or an AWS KMS identity bound with an ML_DSA_65 key (mldsa_signing_key_arn)",
        "The signer's public identity and independently trusted fingerprint"
      ],
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.204"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/kms.key.bind",
        "ipg:operation/sign",
        "ipg:operation/verify"
      ]
    },
    {
      "@id": "ipg:application/hardware-key-custody",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/hardware-custody"
      ],
      "guidance": "Create the identity on a token with hardware.key.generate, bind vendor-generated keys with hardware.key.bind, or create TPM keys with tpm.key.generate; then use the resulting file as the key input. MCP hosts can add --key-custody hardware to refuse software keys.",
      "id": "hardware-key-custody",
      "keywords": [
        "hardware",
        "hsm",
        "token",
        "smartcard",
        "pkcs11",
        "cryptoki",
        "tpm",
        "trusted platform module",
        "non exportable",
        "P-384",
        "ECDSA",
        "ECDH"
      ],
      "label": "Keep private keys in a hardware token or HSM",
      "limitations": [
        "P-384 identities only; IPG never substitutes another curve",
        "Tokens supporting CKD_SHA384_KDF and CKM_AES_GCM decrypt entirely in-token; others, TPMs and KMS release one per-envelope ECDH shared secret into process memory",
        "Protection flags are self-reported token attributes, not vendor attestation; counterparties cannot see custody",
        "The module runs inside the IPG process with its privileges",
        "No token PIN, object or policy administration",
        "TPM key files are the only copy of the wrapped keys and load only in the originating TPM; tpm2-pkcs11 tokens lack ECDH and cannot decrypt through PKCS#11"
      ],
      "prerequisites": [
        "PKCS#11: an ipg build with the pkcs11 feature, host-set IPG_PKCS11_MODULE, and a token supporting P-384 with CKM_EC_KEY_PAIR_GEN, CKM_ECDSA and CKM_ECDH1_DERIVE",
        "TPM: an ipg build with the tpm feature and a TPM 2.0 supporting P-384; on Linux also host-set IPG_TPM_TCTI and an owner hierarchy with empty authorization, on Windows the Microsoft Platform Crypto Provider",
        "PIN in an access-controlled file"
      ],
      "sources": [
        "https://docs.oasis-open.org/pkcs11/pkcs11-spec/v3.1/pkcs11-spec-v3.1.html",
        "https://trustedcomputinggroup.org/resource/tpm-library-specification/",
        "https://doi.org/10.6028/NIST.FIPS.186-5",
        "https://doi.org/10.6028/NIST.SP.800-56Ar3"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/hardware.tokens",
        "ipg:operation/hardware.key.generate",
        "ipg:operation/hardware.key.bind",
        "ipg:operation/tpm.info",
        "ipg:operation/tpm.key.generate",
        "ipg:operation/tpm.key.delete",
        "ipg:operation/key.public",
        "ipg:operation/decrypt",
        "ipg:operation/sign",
        "ipg:operation/key.revoke",
        "ipg:operation/key.validity"
      ]
    },
    {
      "@id": "ipg:application/tpm-key-attestation",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/custody-assurance"
      ],
      "guidance": "The prover runs tpm.attest and sends the evidence. The verifier runs tpm.attestation.challenge with its accepted manufacturer roots, keeps the secret file, and sends the challenge. The prover runs tpm.attestation.respond; the verifier checks the response with tpm.attestation.verify.",
      "id": "tpm-key-attestation",
      "keywords": [
        "attestation",
        "attest",
        "tpm attestation",
        "key attestation",
        "endorsement key",
        "ek certificate",
        "remote attestation"
      ],
      "label": "Prove keys are resident in a genuine TPM",
      "limitations": [
        "Proves key residency and attributes only, not host software state or PIN secrecy",
        "RSA-2048 endorsement keys only; EK certificates are not checked for revocation",
        "ipg-cng-key-v1 keys cannot be attested",
        "A point-in-time statement; use each challenge once"
      ],
      "prerequisites": [
        "An ipg-tpm-key-v1 identity from tpm.key.generate (Linux or Windows)",
        "The TPM's EK certificate (TPM NV on Linux; Windows retrieves it)",
        "Root certificates of the TPM manufacturers the verifier accepts",
        "On Windows, an elevated process for tpm.attestation.respond"
      ],
      "sources": [
        "https://trustedcomputinggroup.org/resource/tpm-library-specification/"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/tpm.attest",
        "ipg:operation/tpm.attestation.challenge",
        "ipg:operation/tpm.attestation.respond",
        "ipg:operation/tpm.attestation.verify"
      ]
    },
    {
      "@id": "ipg:application/managed-kms-custody",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/service-custody"
      ],
      "guidance": "Create the two KMS keys in infrastructure code, bind them with kms.key.bind, and use the resulting file as the key without passphrase_file. Set IPG_KMS_FIPS=1 for FIPS endpoints. MCP hosts can add --key-custody non-exportable.",
      "id": "managed-kms-custody",
      "keywords": [
        "aws kms",
        "kms",
        "cloud key",
        "managed key",
        "key management service",
        "govcloud"
      ],
      "label": "Keep private keys in a cloud key management service",
      "limitations": [
        "AWS KMS only; IPG never creates KMS keys",
        "SSO profiles need a current `aws sso login`; IPG never refreshes SSO tokens",
        "Every private-key operation is a billable network call to AWS",
        "Decryption releases one per-envelope shared secret into process memory"
      ],
      "prerequisites": [
        "An ipg build with the kms feature",
        "Host AWS credentials allowed kms:GetPublicKey, kms:Sign and kms:DeriveSharedSecret",
        "One ECC_NIST_P384 KEY_AGREEMENT key and one ECC_NIST_P384 SIGN_VERIFY key, created with infrastructure tooling; optionally an ML_DSA_65 SIGN_VERIFY key for composite post-quantum signatures"
      ],
      "sources": [
        "https://docs.aws.amazon.com/kms/latest/APIReference/API_DeriveSharedSecret.html",
        "https://docs.aws.amazon.com/kms/latest/APIReference/API_Sign.html",
        "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_sigv.html"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/kms.key.bind",
        "ipg:operation/key.public",
        "ipg:operation/decrypt",
        "ipg:operation/sign",
        "ipg:operation/key.revoke",
        "ipg:operation/key.validity"
      ]
    },
    {
      "@id": "ipg:application/validated-cryptographic-module",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/validated-module"
      ],
      "guidance": "Do not infer validation from an algorithm name; IPG has no validated mode. Hardware identities keep private-key operations in the PKCS#11 module, whose own validation status and approved-mode configuration must be verified separately.",
      "id": "validated-cryptographic-module",
      "keywords": [
        "fips",
        "validated",
        "compliance",
        "certified"
      ],
      "label": "Require a FIPS-validated cryptographic module",
      "limitations": [
        "IPG makes no FIPS validation claim",
        "Outside in-token decryption, the envelope KDF and AES-GCM for hardware identities run in IronCrypto, which holds no CMVP certificate"
      ],
      "prerequisites": [
        "Independent verification of the required module validation and exact deployment configuration"
      ],
      "sources": [],
      "support": "external_required",
      "tools": []
    },
