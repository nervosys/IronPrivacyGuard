    {
      "@id": "ipg:workflow/exchange-with-gnupg",
      "@type": "ipg:Workflow",
      "steps": {
        "@list": [
          {
            "@id": "ipg:operation/openpgp.key.generate"
          },
          {
            "@id": "ipg:operation/openpgp.cert.export"
          },
          {
            "@id": "ipg:operation/openpgp.cert.inspect"
          },
          {
            "@id": "ipg:operation/openpgp.encrypt"
          },
          {
            "@id": "ipg:operation/openpgp.decrypt"
          },
          {
            "@id": "ipg:operation/openpgp.sign"
          },
          {
            "@id": "ipg:operation/openpgp.verify"
          }
        ]
      }
    },
    {
      "@id": "ipg:workflow/confidential-transfer",
      "@type": "ipg:Workflow",
      "steps": {
        "@list": [
          {
            "@id": "ipg:operation/encrypt"
          },
          {
            "@id": "ipg:operation/decrypt"
          }
        ]
      }
    },
    {
      "@id": "ipg:workflow/group-transfer",
      "@type": "ipg:Workflow",
