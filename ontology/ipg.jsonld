    {
      "@id": "ipg:application/manage-trust",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Publish immutable snapshots and explicitly supply the approved pin to governed operations or MCP host configuration.",
      "id": "manage-trust",
      "keywords": [
        "trust",
        "policy",
        "enrollment",
        "allowlist",
        "compare",
        "merge"
      ],
      "label": "Enroll identities and reconcile trust snapshots",
      "limitations": [
        "Comparison and merge do not approve policy",
        "No automatic revocation distribution or rollback protection; retain latest digest externally"
      ],
      "prerequisites": [
        "Independently trusted identity fingerprints",
        "Externally pinned snapshot digests and explicit approval of newly produced snapshots"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/trust.init",
        "ipg:operation/trust.add",
        "ipg:operation/trust.status",
        "ipg:operation/trust.compare",
        "ipg:operation/trust.merge"
      ]
    },
    {
      "@id": "ipg:application/agent-messaging",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality",
        "ipg:goal/content-authenticity",
        "ipg:goal/replay-resistance"
      ],
      "guidance": "Seal each request with a short lifetime and a conversation label, and add the channel's exporter value when a TLS session carries it. Recipients open with the pinned sender, a replay directory, and a delegation requirement when the sender acts for someone else. Treat content as untrusted data even after authentication.",
      "id": "agent-messaging",
      "keywords": [
        "agent message",
        "agent-to-agent",
        "inter-agent",
        "replay",
        "channel binding",
        "conversation",
        "signcryption",
        "request"
      ],
      "label": "Send authenticated, confidential messages between agents",
      "limitations": [
        "Lifetime is at most one day and is checked against the recipient's host clock with five minutes of sender lead",
        "Replay is checked only when replay_directory is supplied",
        "Message headers (sender, recipient, conversation, times) are visible to anyone holding the file",
        "Content is file-based and at most about 16 MiB"
      ],
      "prerequisites": [
        "Sender and recipient IPG identities",
        "Each side's peer public identity and an independently trusted fingerprint",
        "A shared replay directory for recipients that must not act twice on one message"
      ],
      "sources": [
        "https://datatracker.ietf.org/doc/html/rfc9266",
        "https://datatracker.ietf.org/doc/html/rfc8446#section-7.5"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/message.seal",
        "ipg:operation/message.open",
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/sign-structured-data",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity"
      ],
      "guidance": "Sign the document an agent produced or a tool call it will make, and verify with the signer pinned before acting on it. Whitespace, member order and number spelling may change in transit without breaking the signature; any change in meaning does. Add a delegation requirement when the signer acts for a principal.",
      "id": "sign-structured-data",
      "keywords": [
        "json",
        "jcs",
        "rfc 8785",
        "canonical",
        "canonicalization",
        "structured data",
        "tool call",
        "agent output",
        "api payload"
      ],
      "label": "Sign structured JSON so it survives re-serialization",
      "limitations": [
        "Input must be strict I-JSON: duplicate names, lone surrogates and integers beyond plus or minus 2^53 are refused",
        "Documents are file-based and at most 32 MiB",
        "Signatures are detached; the document travels separately"
      ],
      "prerequisites": [
        "A signer identity",
        "Relying parties hold the signer's public identity and an independently trusted fingerprint"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8785",
        "https://www.rfc-editor.org/rfc/rfc7493"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/json.canonicalize",
        "ipg:operation/json.sign",
        "ipg:operation/json.verify"
      ]
    },
    {
      "@id": "ipg:application/agent-action-provenance",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity",
        "ipg:goal/provenance"
      ],
      "guidance": "Attest each consequential action with the outputs as subjects, the inputs as materials, a short action label and the grant's purpose. Verifiers pin the agent, check every artifact they will use, require the expected action, and add a delegation requirement so only authorized agents' statements count.",
      "id": "agent-action-provenance",
      "keywords": [
        "provenance",
        "in-toto",
        "dsse",
        "supply chain",
        "slsa",
        "agent action",
        "build",
        "produced",
        "materials"
      ],
      "label": "Record verifiable provenance of agent actions",
      "limitations": [
        "A statement is the agent's signed claim, not proof the action happened as described",
        "Digests are SHA-384 only; other algorithms in foreign statements are ignored",
        "Ed25519 and ECDSA P-384 envelopes verify with standard DSSE tooling; composite post-quantum signatures need IPG",
        "At most 64 subjects and 64 materials"
      ],
      "prerequisites": [
        "The acting agent's identity",
        "Relying parties hold the agent's public identity and an independently trusted fingerprint",
        "The artifact files to check against the statement"
      ],
      "sources": [
        "https://github.com/in-toto/attestation/blob/main/spec/v1/statement.md",
        "https://github.com/secure-systems-lab/dsse/blob/master/protocol.md",
        "https://slsa.dev/spec/v1.0/"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/provenance.attest",
        "ipg:operation/provenance.verify",
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/mls-agent-groups",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality",
        "ipg:goal/content-authenticity",
        "ipg:goal/forward-secrecy"
      ],
      "guidance": "Have each agent publish a KeyPackage, add agents with mls.commit using their pinned fingerprints, and deliver every commit to every member in order. Use mls.process for each received message and compare epoch authenticators out of band when stakes are high. Commit regularly (an empty commit refreshes the sender) for post-compromise security.",
      "id": "mls-agent-groups",
      "keywords": [
        "mls",
        "rfc 9420",
        "group chat",
        "group encryption",
        "ratchet tree",
        "multi-agent",
        "swarm",
        "forward secrecy",
        "post-compromise"
      ],
      "label": "Run an end-to-end encrypted group of agents with MLS",
      "limitations": [
        "Cipher suites 1 and 3 only: X25519, not post-quantum",
        "No external commits or ReInit",
        "State files are replaced in place; keep no stale copies",
        "The delivery service must order commits; concurrent commits fork the group"
      ],
      "prerequisites": [
        "An IPG identity per agent",
        "Pinned fingerprints of agents to add",
        "A delivery channel that gives every member each commit in order"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9420",
        "https://www.rfc-editor.org/rfc/rfc9750"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/mls.key_package",
        "ipg:operation/mls.group.create",
        "ipg:operation/mls.commit",
        "ipg:operation/mls.join",
        "ipg:operation/mls.encrypt",
        "ipg:operation/mls.process",
        "ipg:operation/mls.status",
        "ipg:operation/mls.export"
      ]
    },
    {
      "@id": "ipg:application/threshold-backup",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/availability",
        "ipg:goal/confidentiality"
      ],
      "guidance": "Split an already passphrase-protected key file so recovery still needs the passphrase. Give each share to a different custodian or location, record the set ID, and test recovery with backup.combine. Re-split and destroy old shares when custodians change.",
      "id": "threshold-backup",
      "keywords": [
        "backup",
        "shamir",
        "secret sharing",
        "threshold",
        "k-of-n",
        "recovery",
        "escrow",
        "custodians"
      ],
      "label": "Back up a key so k of n custodians can recover it",
      "limitations": [
        "Any k custodians together can recover the file",
        "Every share reveals the protected file's length",
        "At most 16 shares and 1 MiB per backup",
        "Shares are not signed: authenticity comes from recovering the sealed file, not from who held a share"
      ],
      "prerequisites": [
        "The file to protect, preferably a passphrase-protected key",
        "n custodians who store their shares separately"
      ],
      "sources": [
        "https://dl.acm.org/doi/10.1145/359168.359176"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/backup.split",
        "ipg:operation/backup.combine"
      ]
    },
    {
      "@id": "ipg:application/rotate-identity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Generate the successor, run key.rotate with both keys and publish the statement. Relying parties run rotation.verify from their pinned fingerprint, check trust snapshots for revocations, then pin the new fingerprint with trust.add. Revoke the old key once peers have moved.",
      "id": "rotate-identity",
      "keywords": [
        "rotation",
        "rotate",
        "key rollover",
        "successor",
        "key update",
        "rekey",
        "migrate key"
      ],
      "label": "Rotate an identity to a successor key",
      "limitations": [
        "Not revocation: the previous key stays valid until revoked or expired",
        "Proves nothing if the previous key was compromised; revoke instead",
        "Chains of at most 16 statements"
      ],
      "prerequisites": [
        "Both the current and the successor private keys",
        "Relying parties hold a pinned fingerprint of an identity earlier in the chain"
      ],
      "sources": [
        "https://csrc.nist.gov/pubs/sp/800/57/pt1/r5/final"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/key.rotate",
        "ipg:operation/rotation.verify",
        "ipg:operation/trust.add"
      ]
    },
    {
      "@id": "ipg:application/tamper-evident-audit",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/integrity",
        "ipg:goal/accountability"
      ],
      "guidance": "Start MCP hosts with --audit-log so every tool call is recorded before and after it runs. Checkpoint the log regularly with a separate identity and hand checkpoints to another party or agent. Verify with every checkpoint you hold; treat unanchored_entries as unprotected.",
      "id": "tamper-evident-audit",
      "keywords": [
        "audit",
        "audit log",
        "tamper-evident",
        "hash chain",
        "append-only",
        "transparency",
        "forensics",
        "accountability"
      ],
      "label": "Keep a tamper-evident audit log of agent activity",
      "limitations": [
        "Anyone who can write the file can append events; checkpoints attribute history, not individual events",
        "Entries after the latest checkpoint can be truncated undetectably",
        "Writers coordinate through a <log>.lock file; a crashed writer leaves it behind",
        "At most 64 KiB per event and 1 GiB per log"
      ],
      "prerequisites": [
        "A writable log file on the host",
        "A checkpoint signer identity whose public identity verifiers pin",
        "Somewhere the log holder cannot rewrite to keep checkpoints"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9162",
        "https://www.usenix.org/legacy/event/sec09/tech/full_papers/crosby.pdf"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/audit.init",
        "ipg:operation/audit.append",
        "ipg:operation/audit.checkpoint",
        "ipg:operation/audit.verify"
      ]
    },
    {
      "@id": "ipg:application/quorum-approval",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity",
        "ipg:goal/separation-of-duties"
      ],
      "guidance": "Have approvers sign the exact plan (rfc8785 for JSON) with a narrow action label and short lifetime. The executing agent runs quorum.verify with the pinned approver set, threshold and a trust snapshot, and proceeds only when it succeeds. Treat rejected approvals as signals to investigate, never as approvals to retry with lower thresholds.",
      "id": "quorum-approval",
      "keywords": [
        "quorum",
        "threshold",
        "m-of-n",
        "multi-party approval",
        "two-person rule",
        "human in the loop",
        "sign-off",
        "consensus"
      ],
      "label": "Require m-of-n approvals before an agent acts",
      "limitations": [
        "Approvals last at most seven days and are checked at the verifier's host clock",
        "Up to 32 approvers and 64 approval files",
        "An approval can be presented to any verifier until it expires; bind one-time actions to unique content such as a nonce in the plan",
        "Not threshold cryptography: each approver signs separately"
      ],
      "prerequisites": [
        "Each approver's identity",
        "The relying party pins every approver's public identity and fingerprint",
        "All approvers approve the same content in the same content mode and action"
      ],
      "sources": [
        "https://csrc.nist.gov/glossary/term/two_person_integrity",
        "https://www.rfc-editor.org/rfc/rfc8785"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/approval.sign",
        "ipg:operation/quorum.verify",
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/delegate-agent-authority",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/delegated-authority",
        "ipg:goal/identity-policy"
      ],
      "guidance": "Issue a short-lived grant naming only the operations and purposes the agent needs, with delegation_depth 0 unless it must re-delegate. Relying parties pass a delegation requirement to verify or stream.verify with the root pinned, and treat a purpose mismatch or expiry as refusal, never as a prompt to widen the grant.",
      "id": "delegate-agent-authority",
      "keywords": [
        "delegation",
        "delegate",
        "agent",
        "multi-agent",
        "on behalf",
        "capability",
        "least privilege",
        "scoped authority"
      ],
      "label": "Delegate scoped signing or decryption authority to an agent",
      "limitations": [
        "Grants are evidence checked at the host clock, not host or filesystem authorization",
        "Purposes are application labels the relying party must interpret",
        "No grant revocation list: keep grants short-lived and revoke compromised keys through trust snapshots",
        "Up to 8 links and depth 7; each link can only narrow its parent"
      ],
      "prerequisites": [
        "The root principal's key and passphrase (or provider credentials) to issue the first grant",
        "Each delegate's public identity and an independently trusted fingerprint",
        "Relying parties hold the root's pinned public identity"
      ],
      "sources": [
        "https://www.w3.org/TR/vc-data-model-2.0/",
        "https://datatracker.ietf.org/doc/html/rfc8693"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/grant.issue",
        "ipg:operation/grant.verify",
        "ipg:operation/sign",
        "ipg:operation/verify",
        "ipg:operation/stream.sign",
        "ipg:operation/stream.verify"
      ]
    },
    {
      "@id": "ipg:application/revoke-identity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Import the authenticated certificate into a new snapshot, then distribute and explicitly adopt its digest.",
      "id": "revoke-identity",
      "keywords": [
        "revocation",
        "compromise",
        "retire",
        "incident"
      ],
      "label": "Revoke an identity and enforce the revocation",
      "limitations": [
        "Certificate creation or verification alone does not enforce revocation",
        "Existing ciphertext and signatures are not erased"
      ],
      "prerequisites": [
        "Identity private key and passphrase to self-revoke",
        "Pinned public identity and trust snapshot to import the certificate"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.revoke",
        "ipg:operation/revocation.verify",
        "ipg:operation/trust.revoke",
        "ipg:operation/trust.status"
      ]
    },
    {
      "@id": "ipg:application/identity-validity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Issue a signed window, import it into a snapshot, and apply that policy to encrypt, sign and verify.",
      "id": "identity-validity",
      "keywords": [
        "expiry",
        "expiration",
        "time",
        "validity",
        "schedule"
      ],
      "label": "Constrain an identity to a signed validity window",
      "limitations": [
        "trust.evaluate is advisory; caller-selected times never authorize execution",
        "Enforcement uses the host clock",
        "Validity imports can narrow existing windows only"
      ],
      "prerequisites": [
        "Signer secret key and passphrase",
        "Unix seconds with not_before strictly less than not_after",
        "Pinned policy adopted by governed operations"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.validity",
        "ipg:operation/validity.verify",
        "ipg:operation/trust.validity",
        "ipg:operation/trust.evaluate"
      ]
    },
    {
      "@id": "ipg:application/inspect-artifact",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/structural-validation"
      ],
      "guidance": "Use inspect to route an artifact, then explicitly invoke the appropriate authentication operation.",
      "id": "inspect-artifact",
      "keywords": [
        "inspect",
        "format",
        "metadata",
        "parse"
      ],
      "label": "Identify a native artifact and validate its structure",
      "limitations": [
        "Inspection does not authenticate the artifact or trust embedded metadata"
      ],
      "prerequisites": [
        "Bounded native IPG artifact file"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/openpgp-interoperability",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/protocol-interoperability"
      ],
      "guidance": "Import a pinned supported transferable secret key with openpgp.key.import and a new IPG wrapping passphrase, or generate an OpenPGP key with openpgp.key.generate (algorithm p384 for CNSA-aligned deployments), export a pinned protected private-key backup with openpgp.key.export using a new passphrase file, share the public certificate from openpgp.cert.export, and review correspondents' certificates with openpgp.cert.inspect before pinning their fingerprints. openpgp.encrypt accepts up to 32 recipients; decrypt and sign with the IPG-held key; verify detached signatures with openpgp.verify or publish authenticated embedded signed content with openpgp.message.verify.",
      "id": "openpgp-interoperability",
      "keywords": [
        "pgp",
        "gpg",
        "openpgp",
        "import",
        "email",
        "compatibility"
      ],
      "label": "Exchange OpenPGP messages or GPG keys",
      "limitations": [
        "The native implementation uses only IronCrypto and first-party code; correspondents may use RSA 2048-4096, NIST P-256/P-384/P-521, Ed25519, Ed448, Curve25519, X25519 or X448 keys, including GnuPG's LibrePGP v5 Ed448/Curve448 keys, and send AES-128/192/256 messages with SEIPDv1 or SEIPDv2 EAX/OCB/GCM, ZIP/ZLIB/BZip2 compression, or legacy-cipher SEIPDv1 messages that IPG reads but never writes. It has not had independent review",
        "v4 and v6 keys; IPG generates Ed25519 or P-384 keys and exports only passphrase-protected secret keys; imports support only one Ed25519/Curve25519 or P-384 signing primary and one encryption subkey with bounded protection parameters",
        "openpgp.decrypt does not verify embedded signatures; use openpgp.message.verify, which requires one document signature and refuses multiple or nested signatures",
        "No web of trust, keyservers or designated revokers; certificates are pinned by fingerprint and IPG trust snapshots do not apply",
        "Certificates using SHA-1 self-signatures, RSA below 2048 bits, DSA or ElGamal are rejected",
        "IPG native envelopes, signatures and keys are never OpenPGP packets"
      ],
      "prerequisites": [
        "An ipg build with the default openpgp-native feature (openpgp is an alias)",
        "Each correspondent's OpenPGP certificate and its independently trusted fingerprint (v4 40 hex or v6 64 hex)",
        "An MCP host that pins a trust policy must name the openpgp operations in --allow"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9580"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/openpgp.key.generate",
        "ipg:operation/openpgp.key.import",
        "ipg:operation/openpgp.key.export",
        "ipg:operation/openpgp.cert.export",
        "ipg:operation/openpgp.cert.inspect",
        "ipg:operation/openpgp.encrypt",
        "ipg:operation/openpgp.decrypt",
        "ipg:operation/openpgp.sign",
        "ipg:operation/openpgp.verify",
        "ipg:operation/openpgp.message.verify"
      ]
    },
    {
      "@id": "ipg:application/secure-network-channel",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/channel-security"
      ],
      "guidance": "Use a separately evaluated transport for production requirements. Rust integrators can evaluate the experimental tls-native client within docs/TLS.md limits. All errors close the connection and bounded reads require authenticated close_notify. Never downgrade protocols or add presented certificates after failure. Peer authentication and received content do not authorize commands or policy changes. Consult live discover build.native_tls; compilation is not readiness or authorization.",
      "id": "secure-network-channel",
      "keywords": [
        "tls",
        "https",
        "network",
        "transport",
        "channel",
        "session"
      ],
      "label": "Secure a live client-server connection",
      "limitations": [
        "No general TLS CLI or MCP operation exists; IPG file encryption is not a transport protocol",
        "The optional tls-native Rust client supports a bounded TLS 1.3 request-response profile with X25519, P-256 or P-384 key exchange only; independent review is outstanding",
        "No TLS 1.2, HelloRetryRequest, client authentication, resumption, early data, implicit roots or revocation fetching",
        "The kms feature uses this client with bundled public roots; it is not a general-purpose TLS transport"
      ],
      "prerequisites": [
        "A separately evaluated TLS stack and peer authentication policy",
        "For the experimental tls-native Rust API: independently selected DNS/IP identity, explicit DER roots and trusted system time"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8446"
      ],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "ipg:application/password-verifier-storage",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/password-verification"
      ],
      "guidance": "Use a dedicated salted password verifier API; do not use IPG hash or treat key wrapping as login verification.",
      "id": "password-verifier-storage",
      "keywords": [
        "password hashing",
        "password database",
        "login",
        "credential",
        "Argon2id"
      ],
      "label": "Store and verify user login passwords",
      "limitations": [
        "IPG uses Argon2id internally but exposes no password verifier interface",
        "IPG hash is a fast file digest, not password hashing"
      ],
      "prerequisites": [
        "A password hashing and verification implementation with application-specific resource policy"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106"
      ],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "ipg:application/multi-recipient-encryption",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality"
      ],
      "guidance": "Use stream.encrypt with a recipients list of {public, expected_fingerprint} objects; each recipient decrypts with stream.decrypt and its own key file. Streams handle files of any size in 64 KiB authenticated chunks and release plaintext only after the last chunk verifies. openpgp.encrypt covers multi-recipient OpenPGP messages.",
      "id": "multi-recipient-encryption",
      "keywords": [
        "group",
        "multi recipient",
        "many recipients",
        "shared envelope",
        "streaming",
        "chunked"
      ],
      "label": "Encrypt one shared envelope for multiple recipients",
      "limitations": [
        "No sender authentication: any recipient could re-encrypt other content to the others; sign streams when origin matters",
        "Streams are binary files; ipg-envelope-v1 (encrypt) stays single-recipient JSON",
        "Post-quantum confidentiality holds only for hybrid recipients; the stream is only as strong as each recipient's wrap for that recipient"
      ],
      "prerequisites": [
        "Each recipient's public identity and independently trusted fingerprint (1..64 recipients, any suite)"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/stream.encrypt",
        "ipg:operation/stream.decrypt"
      ]
    },
    {
      "@id": "ipg:application/post-quantum-protection",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/post-quantum-security",
        "ipg:goal/confidentiality"
      ],
      "guidance": "Create a hybrid identity with ipg key generate --identity ipg-public-hybrid-v1. Encryption to that identity then always uses the hybrid envelope suite; there is no negotiation or fallback.",
      "id": "post-quantum-protection",
      "keywords": [
        "post quantum",
        "pqc",
        "quantum resistant",
        "harvest now decrypt later",
        "ml kem",
        "kyber",
        "hybrid",
        "encryption"
      ],
      "label": "Hybrid post-quantum encryption against future quantum attacks",
      "limitations": [
        "Fingerprints and trust-snapshot digests use SHA-384; signatures are composite Ed25519 plus ML-DSA-65 (see quantum-resistant-signing)",
        "Envelopes stay secure only while ML-KEM-768 or X25519 is unbroken; the combination has not had independent review",
        "IronCrypto's ML-KEM is marked experimental upstream; IPG checks it against PyCA and OpenSSL only",
        "Software secret keys only; hardware identities have no post-quantum suite"
      ],
      "prerequisites": [
        "Generate the recipient with key.generate identity ipg-public-hybrid-v1",
        "Recipient hybrid public identity and independently trusted fingerprint"
      ],
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.203",
        "https://www.rfc-editor.org/rfc/rfc7748",
        "https://www.rfc-editor.org/rfc/rfc5869"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/key.public",
        "ipg:operation/encrypt",
        "ipg:operation/decrypt"
      ]
    },
    {
      "@id": "ipg:application/quantum-resistant-signing",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/quantum-resistant-authenticity"
      ],
      "guidance": "Sign with a hybrid identity, or bind AWS KMS keys with mldsa_signing_key_arn for KMS custody; every signature, revocation and validity certificate then requires both the classical and the ML-DSA-65 signature to verify, so it stays unforgeable while either holds.",
      "id": "quantum-resistant-signing",
      "keywords": [
        "pq signing",
        "quantum resistant signing",
        "ml dsa",
        "dilithium",
        "composite signing"
      ],
      "label": "Require quantum-resistant signing",
      "limitations": [
        "Composite ed25519-mldsa65 (software) or ecdsa-p384-mldsa65 (AWS KMS) only; no SLH-DSA or standalone ML-DSA",
        "PKCS#11 and TPM identities sign with ECDSA P-384 only",
        "KMS post-quantum identities keep P-384 encryption, since KMS has no ML-KEM",
        "IronCrypto's ML-DSA is marked experimental upstream; IPG checks it against PyCA and OpenSSL",
        "Signatures are about 3.4 KB and not interoperable with other composite-signature formats"
      ],
      "prerequisites": [
        "A hybrid identity from key.generate identity ipg-public-hybrid-v1, or an AWS KMS identity bound with an ML_DSA_65 key (mldsa_signing_key_arn)",
        "The signer's public identity and independently trusted fingerprint"
      ],
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.204"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/kms.key.bind",
        "ipg:operation/sign",
        "ipg:operation/verify"
      ]
    },
    {
      "@id": "ipg:application/hardware-key-custody",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/hardware-custody"
      ],
      "guidance": "Create the identity on a token with hardware.key.generate, bind vendor-generated keys with hardware.key.bind, or create TPM keys with tpm.key.generate; then use the resulting file as the key input. MCP hosts can add --key-custody hardware to refuse software keys.",
      "id": "hardware-key-custody",
      "keywords": [
        "hardware",
        "hsm",
        "token",
        "smartcard",
        "pkcs11",
        "cryptoki",
        "tpm",
        "trusted platform module",
        "non exportable",
        "P-384",
        "ECDSA",
        "ECDH"
      ],
      "label": "Keep private keys in a hardware token or HSM",
      "limitations": [
        "P-384 identities only; IPG never substitutes another curve",
        "Tokens supporting CKD_SHA384_KDF and CKM_AES_GCM decrypt entirely in-token; others, TPMs and KMS release one per-envelope ECDH shared secret into process memory",
        "Protection flags are self-reported token attributes, not vendor attestation; counterparties cannot see custody",
        "The module runs inside the IPG process with its privileges",
        "No token PIN, object or policy administration",
        "TPM key files are the only copy of the wrapped keys and load only in the originating TPM; tpm2-pkcs11 tokens lack ECDH and cannot decrypt through PKCS#11"
      ],
      "prerequisites": [
        "PKCS#11: an ipg build with the pkcs11 feature, host-set IPG_PKCS11_MODULE, and a token supporting P-384 with CKM_EC_KEY_PAIR_GEN, CKM_ECDSA and CKM_ECDH1_DERIVE",
        "TPM: an ipg build with the tpm feature and a TPM 2.0 supporting P-384; on Linux also host-set IPG_TPM_TCTI and an owner hierarchy with empty authorization; Windows uses TPM Base Services for native keys and the Platform Crypto Provider for older ipg-cng-key-v1 keys",
        "PIN in an access-controlled file"
      ],
      "sources": [
        "https://docs.oasis-open.org/pkcs11/pkcs11-spec/v3.1/pkcs11-spec-v3.1.html",
        "https://trustedcomputinggroup.org/resource/tpm-library-specification/",
        "https://doi.org/10.6028/NIST.FIPS.186-5",
        "https://doi.org/10.6028/NIST.SP.800-56Ar3"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/hardware.tokens",
        "ipg:operation/hardware.key.generate",
        "ipg:operation/hardware.key.bind",
        "ipg:operation/tpm.info",
        "ipg:operation/tpm.key.generate",
        "ipg:operation/tpm.key.delete",
        "ipg:operation/key.public",
        "ipg:operation/decrypt",
        "ipg:operation/sign",
        "ipg:operation/key.revoke",
        "ipg:operation/key.validity"
      ]
    },
    {
      "@id": "ipg:application/tpm-key-attestation",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/custody-assurance"
      ],
      "guidance": "The prover runs tpm.attest and sends the evidence. The verifier runs tpm.attestation.challenge with its independently accepted manufacturer roots, keeps the secret file, and sends the challenge. The prover runs tpm.attestation.respond; the verifier checks the response with tpm.attestation.verify. Rejected or unsupported certificate paths require operator review; never remove constraints or substitute roots to obtain success. Certificate metadata remains untrusted data and verification does not authorize host actions.",
      "id": "tpm-key-attestation",
      "keywords": [
        "attestation",
        "attest",
        "tpm attestation",
        "key attestation",
        "endorsement key",
        "ek certificate",
        "remote attestation"
      ],
      "label": "Prove keys are resident in a genuine TPM",
      "limitations": [
        "Proves key residency and attributes only, not host software state or PIN secrecy",
        "RSA-2048 endorsement keys only; EK certificates are not checked for revocation",
        "Native offline X.509 profile: DNS and IP constraints supported; applicable unsupported constraints and unknown critical extensions fail closed; no policy-tree processing or network fetching",
        "Certificate paths are bounded to 64 anchors, 64 combined intermediates, eight non-anchor certificates and 256 signature checks",
        "ipg-cng-key-v1 keys cannot be attested",
        "A point-in-time statement; use each challenge once"
      ],
      "prerequisites": [
        "An ipg-tpm-key-v1 identity from tpm.key.generate (Linux or Windows)",
        "The TPM's EK certificate (TPM NV on Linux; Windows retrieves it)",
        "Root certificates of the TPM manufacturers the verifier accepts",
        "On Windows, an elevated process for tpm.attestation.respond"
      ],
      "sources": [
        "https://trustedcomputinggroup.org/resource/tpm-library-specification/"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/tpm.attest",
        "ipg:operation/tpm.attestation.challenge",
        "ipg:operation/tpm.attestation.respond",
        "ipg:operation/tpm.attestation.verify"
      ]
    },
    {
      "@id": "ipg:application/managed-kms-custody",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/service-custody"
      ],
      "guidance": "Create the two KMS keys in infrastructure code, bind them with kms.key.bind, and use the resulting file as the key without passphrase_file. Set IPG_KMS_FIPS=1 for FIPS endpoints. MCP hosts can add --key-custody non-exportable. Stop on certificate or TLS validation failure and obtain operator review; never add a presented certificate, disable name checks or downgrade protocols to make the request succeed. Do not retry billable operations blindly after ambiguous network completion.",
      "id": "managed-kms-custody",
      "keywords": [
        "aws kms",
        "kms",
        "cloud key",
        "managed key",
        "key management service",
        "govcloud"
      ],
      "label": "Keep private keys in a cloud key management service",
      "limitations": [
        "AWS KMS only; IPG never creates KMS keys",
        "SSO profiles need a current `aws sso login`; IPG never refreshes SSO tokens",
        "Every private-key operation is a billable network call to AWS",
        "Decryption releases one per-envelope shared secret into process memory",
        "TLS uses IPG's native TLS 1.3 client on IronCrypto and refuses TLS 1.2-only endpoints; bundled public roots require a reviewed rebuild to update and do not follow OS trust or revocation policy",
        "Certificate and TLS validation failures are non-retryable"
      ],
      "prerequisites": [
        "An ipg build with the kms feature",
        "Host AWS credentials allowed kms:GetPublicKey, kms:Sign and kms:DeriveSharedSecret",
        "One ECC_NIST_P384 KEY_AGREEMENT key and one ECC_NIST_P384 SIGN_VERIFY key, created with infrastructure tooling; optionally an ML_DSA_65 SIGN_VERIFY key for composite post-quantum signatures"
      ],
      "sources": [
        "https://docs.aws.amazon.com/kms/latest/APIReference/API_DeriveSharedSecret.html",
        "https://docs.aws.amazon.com/kms/latest/APIReference/API_Sign.html",
        "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_sigv.html"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/kms.key.bind",
        "ipg:operation/key.public",
        "ipg:operation/decrypt",
        "ipg:operation/sign",
        "ipg:operation/key.revoke",
        "ipg:operation/key.validity"
      ]
    },
    {
      "@id": "ipg:application/validated-cryptographic-module",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/validated-module"
      ],
      "guidance": "Do not infer validation from an algorithm name; IPG has no validated mode. Hardware identities keep private-key operations in the PKCS#11 module, whose own validation status and approved-mode configuration must be verified separately.",
      "id": "validated-cryptographic-module",
      "keywords": [
        "fips",
        "validated",
        "compliance",
        "certified"
      ],
      "label": "Require a FIPS-validated cryptographic module",
      "limitations": [
        "IPG makes no FIPS validation claim",
        "Outside in-token decryption, the envelope KDF and AES-GCM for hardware identities run in IronCrypto, which holds no CMVP certificate"
      ],
      "prerequisites": [
        "Independent verification of the required module validation and exact deployment configuration"
      ],
      "sources": [],
      "support": "external_required",
      "tools": []
    },
