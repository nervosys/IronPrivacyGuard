{
  "@context": {
    "@vocab": "urn:ipg:v1:",
    "algorithms": {
      "@type": "@id"
    },
    "constraints": {
      "@type": "@id"
    },
    "goals": {
      "@type": "@id"
    },
    "ic": "urn:ironcrypto:algorithm:",
    "inputs": {
      "@type": "@id"
    },
    "ipg": "urn:ipg:v1:",
    "optional_inputs": {
      "@type": "@id"
    },
    "outputs": {
      "@type": "@id"
    },
    "sources": {
      "@type": "@id"
    },
    "tools": {
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "ipg:KnowledgeQuery",
      "@type": "ipg:Entity",
      "description": "1..256 Unicode characters with an alphanumeric token; deterministic keyword search",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KnowledgeBase",
      "@type": "ipg:Entity",
      "description": "Centralized curated application guidance and tool mappings",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KnowledgeSelection",
      "@type": "ipg:Entity",
      "description": "Deterministic keyword matches; not approval or authorization",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:CandidateRequest",
      "@type": "ipg:Entity",
      "description": "Untrusted JSON proposed as an IPG Request object; not a Call envelope",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:RequestValidation",
      "@type": "ipg:Entity",
      "description": "Static preflight issues with JSON Pointers; no authentication or authorization claim",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustComparison",
      "@type": "ipg:Entity",
      "description": "Ordered snapshot changes and structural extension compatibility; not approval or a freshness proof",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Validity",
      "@type": "ipg:Entity",
      "description": "Self-signed entire-identity half-open validity window [not_before, not_after)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:UnixTime",
      "@type": "ipg:Entity",
      "description": "Integer Unix seconds from 0 through 253402300799",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:ValidityVerification",
      "@type": "ipg:Entity",
      "description": "Authenticated validity evidence; does not apply policy",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TrustEvaluation",
      "@type": "ipg:Entity",
      "description": "Advisory permitted, revoked, not_yet_valid or expired at a supplied time",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:McpTransport",
      "@type": "ipg:Entity",
      "description": "Newline-delimited JSON-RPC stdio; initialize, initialized notification, ping, tools/list and tools/call",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:McpHostPolicy",
      "@type": "ipg:Entity",
      "description": "Startup-selected trust snapshot injected into encrypt, stream.encrypt, sign, stream.sign, verify and stream.verify, and optional hardware key custody requirement; tool callers cannot replace either",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TokenInventory",
      "@type": "ipg:Entity",
      "description": "Tokens visible through the host-configured PKCS#11 module with advertised mechanisms; advisory, no login",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TokenSerial",
      "@type": "ipg:Entity",
      "description": "PKCS#11 token serial number selecting exactly one present token",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KeyLabel",
      "@type": "ipg:Entity",
      "description": "CKA_LABEL of 1..64 bytes written to generated token objects; informational, never used for lookup",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KeyId",
      "@type": "ipg:Entity",
      "description": "PKCS#11 CKA_ID of 1..64 bytes identifying one key pair's public and private objects",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TokenPin",
      "@type": "ipg:Entity",
      "description": "Token user PIN, 1..255 exact file bytes; never a request value",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:KeyDeletion",
      "@type": "ipg:Entity",
      "description": "Confirmation that a TPM-backed identity's persisted keys were permanently deleted",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:StreamCiphertext",
      "@type": "ipg:Entity",
      "description": "ipg-stream-v1: a binary stream with a header wrapping one content key for each of 1..64 recipients and authenticated 64 KiB chunks; does not identify a sender",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:StreamSignature",
      "@type": "ipg:Entity",
      "description": "ipg-stream-signature-v1: detached signature binding the signer, algorithm, SHA-384 digest and u64 byte count of an any-size file; distinct from ordinary detached signatures and external prehash modes",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TpmEvidence",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-evidence-v1: the identity, the TPM's EK public area and certificates, its attestation key and two TPM2_Certify certifications; public, and not a proof until verified with a credential challenge",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TrustAnchors",
      "@type": "ipg:Entity",
      "description": "Root certificates (PEM or DER) of the TPM manufacturers the verifier accepts, chosen by the verifier",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TpmChallenge",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-challenge-v1: a credential encrypted to the TPM's endorsement key for the evidence's attestation key (software TPM2_MakeCredential)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TpmChallengeSecret",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-challenge-secret-v1: the verifier's copy of the challenge credential; keep private and use once",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:TpmAttestationResponse",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-response-v1: the credential the TPM released through TPM2_ActivateCredential",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AttestationReport",
      "@type": "ipg:Entity",
      "description": "What a verification established: EK certificate and anchor digests, TPM firmware, key attributes (fixedTPM, fixedParent, sensitiveDataOrigin) and whether the credential activation was verified",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:OpenpgpKeyFile",
      "@type": "ipg:Entity",
      "description": "ipg-openpgp-key-v1: a v4 or v6 OpenPGP key generated by IPG whose transferable secret key is sealed with Argon2id and ChaCha20-Poly1305; the certificate is public",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "ipg:OpenpgpCertificate",
      "@type": "ipg:Entity",
      "description": "An OpenPGP certificate (transferable public key) file, ASCII-armored or binary; untrusted until pinned by fingerprint",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:OpenpgpSecretKey",
      "@type": "ipg:Entity",
      "description": "Transferable OpenPGP private key, armored or binary; imports may be unprotected, exports always protect every secret packet; keep private",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:OpenpgpFingerprint",
      "@type": "ipg:Entity",
      "description": "OpenPGP primary-key fingerprint: v4 40 or v6 64 hexadecimal characters, either case; distinct from IPG fingerprints",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:OpenpgpUserId",
      "@type": "ipg:Entity",
      "description": "Self-asserted OpenPGP User ID label such as \"Alice <alice@example.org>\"; 1..256 bytes without control characters; never identity proof",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:OpenpgpMessage",
      "@type": "ipg:Entity",
      "description": "ASCII-armored or binary OpenPGP message; IPG writes armored AES-256 messages: SEIPDv1 for v4, SEIPDv2/OCB for v6",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:OpenpgpSignature",
      "@type": "ipg:Entity",
      "description": "Detached OpenPGP document signature, ASCII-armored or binary",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:OpenpgpCertificateReport",
      "@type": "ipg:Entity",
      "description": "A certificate evaluated under IPG policy at host time: per-key algorithm, flags, expiry, revocation, usability and issues",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:OpenpgpVerification",
      "@type": "ipg:Entity",
      "description": "A valid detached OpenPGP signature by a key of the pinned certificate that was valid for signing when it signed; no identity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:KmsKeyFile",
      "@type": "ipg:Entity",
      "description": "Public ipg-kms-key-v1 file binding an identity to AWS KMS key ARNs in one region: two P-384 keys (ipg-public-p384-v1), plus an ML_DSA_65 key for composite post-quantum signatures (ipg-public-p384-mldsa65-v1); using it needs host AWS credentials",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AwsRegion",
      "@type": "ipg:Entity",
      "description": "AWS region holding both KMS keys, for example us-gov-west-1",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KmsKeyArn",
      "@type": "ipg:Entity",
      "description": "Exact KMS key ARN; aliases are refused because they can be repointed",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TpmInventory",
      "@type": "ipg:Entity",
      "description": "Host TPM manufacturer, vendor, firmware, supported curves and owner-hierarchy readiness; advisory",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TpmKeyFile",
      "@type": "ipg:Entity",
      "description": "Host TPM key file for a P-384 identity: ipg-tpm-key-v1 (Linux and Windows) holds TPM-wrapped fixedTPM blobs only the originating TPM can load, so deleting every copy destroys the identity; legacy ipg-cng-key-v1 (Windows) names persisted Platform Crypto Provider keys, removed with tpm.key.delete",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "ipg:HardwareKeyReference",
      "@type": "ipg:Entity",
      "description": "Public ipg-pkcs11-key-v1 file binding a P-384 identity to token serial, label, manufacturer, model and two key IDs; holds no secret material",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ToolAllowlist",
      "@type": "ipg:Entity",
      "description": "Host-selected IPG operation IDs exposed and callable in this MCP session; not a filesystem sandbox",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustStore",
      "@type": "ipg:Entity",
      "description": "Immutable snapshot of explicitly enrolled public identities and retained verified revocations with optional signed validity windows",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustDigest",
      "@type": "ipg:Entity",
      "description": "Externally pinned commitment to a canonical trust snapshot: SHA-384 for ipg-trust-v3, SHA-256 for legacy v1 and v2; not a signature or freshness proof",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustPolicy",
      "@type": "ipg:Entity",
      "description": "Explicit snapshot path and expected digest; requires enrollment, rejects retained revocations and enforces validity at host time",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustStatus",
      "@type": "ipg:Entity",
      "description": "Revocation state in one pinned snapshot; false does not establish global active status",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Revocation",
      "@type": "ipg:Entity",
      "description": "A self-signed request to permanently stop using both keys of an identity; no trusted timestamp",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:RevocationReason",
      "@type": "ipg:Entity",
      "description": "Closed vocabulary: compromised, superseded, retired",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:RevocationVerification",
      "@type": "ipg:Entity",
      "description": "Authenticated certificate evidence; policy_applied is false and no trust state is changed",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Grant",
      "@type": "ipg:Entity",
      "description": "An ipg-grant-v1 delegation chain: signed links from a root principal to an acting identity, each carrying the subject's public identity, operations, purposes, time window and remaining depth",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:GrantVerification",
      "@type": "ipg:Entity",
      "description": "Authority a chain confers at the host clock: root, subject, operations, purposes, window and depth; evidence, not authorization",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:MlsSuite",
      "@type": "ipg:Entity",
      "description": "MLS cipher suite: x25519-chacha20poly1305-sha256-ed25519 (3, default), x25519-aes128gcm-sha256-ed25519 (1) or p384-aes256gcm-sha384-p384 (7)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:MlsKeyPackage",
      "@type": "ipg:Entity",
      "description": "An ipg-mls-key-package-v1 file: the RFC 9420 KeyPackage, its reference and the bound IPG fingerprint; public, single use",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:MlsKeyPackageSecrets",
      "@type": "ipg:Entity",
      "description": "The KeyPackage's init, leaf and MLS signature private keys, sealed under a passphrase; needed with a Welcome to join",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:MlsGroupState",
      "@type": "ipg:Entity",
      "description": "A sealed ipg-mls-state-v1 file holding the group's tree, epoch secrets, ratchets and this member's private keys; replaced in place",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:MlsMessage",
      "@type": "ipg:Entity",
      "description": "RFC 9420 MLSMessage bytes: PrivateMessage commits, proposals and application data, interoperable with other MLS implementations",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:MlsWelcome",
      "@type": "ipg:Entity",
      "description": "RFC 9420 Welcome bytes for members added by a commit, carrying the ratchet tree",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:MlsGroupStatus",
      "@type": "ipg:Entity",
      "description": "Group ID, epoch, suite, this member's fingerprint, every member's bound IPG fingerprint and the epoch authenticator",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:BackupShare",
      "@type": "ipg:Entity",
      "description": "An ipg-share-v1 file: a random set ID, threshold, share count and index, one Shamir share of a 32-byte key, and the ChaCha20-Poly1305-sealed file shared by every share",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:ShareThreshold",
      "@type": "ipg:Entity",
      "description": "The number of shares k needed to recover, 2 <= k <= n <= 16",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Rotation",
      "@type": "ipg:Entity",
      "description": "An ipg-rotation-v1 statement: the previous fingerprint, the successor's complete public identity, a reason (scheduled or upgraded) and host time, signed by both the previous and the successor key",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:RotationVerification",
      "@type": "ipg:Entity",
      "description": "The pinned starting identity, every authenticated successor in order with reasons, and the current identity",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AuditLog",
      "@type": "ipg:Entity",
      "description": "An ipg-audit-v1 log: newline-delimited RFC 8785 JSON, a header with a random log ID, then hash-chained entries (seq, host time, previous hash, event, hash)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AuditEvent",
      "@type": "ipg:Entity",
      "description": "Caller-supplied JSON object of at most 64 KiB; anyone who can write the log can append, so events are claims until anchored and attributed",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:AuditHead",
      "@type": "ipg:Entity",
      "description": "Sequence number and SHA-384 head hash after an append",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AuditCheckpoint",
      "@type": "ipg:Entity",
      "description": "An ipg-audit-checkpoint-v1 signature over a log ID, size, head hash and host time",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AuditVerification",
      "@type": "ipg:Entity",
      "description": "Verified log size, head, time range, checkpoints checked, the latest anchored size and the number of unanchored entries after it",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Approval",
      "@type": "ipg:Entity",
      "description": "An ipg-approval-v1 signature binding an approver to the SHA-384 of specific content, an action, a content mode, creation and expiry (at most 7 days) and a random nonce",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ApprovalContentMode",
      "@type": "ipg:Entity",
      "description": "How approved content is digested: bytes (exact bytes) or rfc8785 (canonical form of strict I-JSON)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:QuorumThreshold",
      "@type": "ipg:Entity",
      "description": "The number m of distinct pinned approvers whose valid approvals are required, 1 <= m <= n <= 32",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:QuorumVerification",
      "@type": "ipg:Entity",
      "description": "Distinct approvers with valid approvals, rejected approvals with reasons, the content digest and the host time of the check",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:JsonDocument",
      "@type": "ipg:Entity",
      "description": "Strict I-JSON (RFC 7493): UTF-8, no duplicate member names, no lone surrogates and integers within plus or minus 2^53; untrusted until a signature over it verifies",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:CanonicalJson",
      "@type": "ipg:Entity",
      "description": "RFC 8785 JSON Canonicalization Scheme bytes: sorted members, no whitespace, ECMAScript numbers and minimal string escapes",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:JsonSignature",
      "@type": "ipg:Entity",
      "description": "An ipg-json-signature-v1 detached signature over the signer fingerprint and the SHA-384 of a document's RFC 8785 canonical form",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ProvenanceArtifact",
      "@type": "ipg:Entity",
      "description": "A named file whose SHA-384 is recorded in a statement as a subject (produced) or material (consumed)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ProvenanceAction",
      "@type": "ipg:Entity",
      "description": "Agent-declared action label of 1..64 ASCII characters, such as build, deploy or review; a claim, not evidence that the action happened",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:ProvenanceStatement",
      "@type": "ipg:Entity",
      "description": "A DSSE envelope (payloadType application/vnd.in-toto+json) holding a canonical in-toto Statement v1 with the IPG agent-action predicate, signed over the DSSE pre-authentication encoding",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ProvenanceVerification",
      "@type": "ipg:Entity",
      "description": "Authenticated statement content (agent, action, purpose, recording time, subjects, materials, parameters, statement digest) and the subjects whose files matched",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Message",
      "@type": "ipg:Entity",
      "description": "An ipg-message-v1 agent message: a signed header (sender, recipient, message ID, conversation, created, expires, channel binding) and an envelope sealing the signature, optional grant and content",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:MessageReceipt",
      "@type": "ipg:Entity",
      "description": "Authenticated message metadata: sender, message ID, conversation, times, whether a replay marker was recorded and any verified delegation",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ConversationLabel",
      "@type": "ipg:Entity",
      "description": "Optional sender-chosen label of 1..128 ASCII characters bound into a message; untrusted until the message authenticates",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:ChannelBinding",
      "@type": "ipg:Entity",
      "description": "Optional 16..64-byte value both peers derive from their channel, such as a TLS exporter, binding a message to that channel",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ReplayDirectory",
      "@type": "ipg:Entity",
      "description": "Host directory of exclusive per-message markers shared by recipients that must not process a message twice",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:DelegableOperation",
      "@type": "ipg:Entity",
      "description": "Closed vocabulary of operations a grant may delegate: approval.sign, audit.checkpoint, decrypt, json.sign, message.open, message.seal, mls.commit, mls.encrypt, mls.export, mls.group.create, mls.join, mls.key_package, mls.process, mls.status, provenance.attest, sign, stream.decrypt, stream.sign",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:GrantPurpose",
      "@type": "ipg:Entity",
      "description": "Application-defined lowercase label narrowing what a delegated signature or decryption is for; untrusted data until a verified grant includes it",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:Artifact",
      "@type": "ipg:Entity",
      "description": "A versioned native IPG JSON file or raw data",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Plaintext",
      "@type": "ipg:Entity",
      "description": "Exact binary content; never emitted in control responses",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:OpenpgpSourcePassword",
      "@type": "ipg:Entity",
      "description": "0..4096 exact file bytes for importing an external secret key; an empty file supports unprotected source packets",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:Passphrase",
      "@type": "ipg:Entity",
      "description": "16..4096 exact file bytes, including any newline",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:PublicKey",
      "@type": "ipg:Entity",
      "description": "Independent encryption and signing public keys bound by a fingerprint: X25519 and Ed25519 (ipg-public-v1), ML-KEM-768 plus X25519 with Ed25519 plus ML-DSA-65 (ipg-public-hybrid-v1), P-384 ECDH and ECDSA (ipg-public-p384-v1), or P-384 ECDH with ECDSA P-384 plus ML-DSA-65 (ipg-public-p384-mldsa65-v1)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:SecretKey",
      "@type": "ipg:Entity",
      "description": "Software identity seeds protected by Argon2id and ChaCha20-Poly1305: 64 bytes (ipg-secret-v1) or 160 bytes including the ML-KEM-768 and ML-DSA-65 seeds (ipg-secret-hybrid-v1)",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "ipg:Fingerprint",
      "@type": "ipg:Entity",
      "description": "Hash of a suite-specific domain-separated length-framed pair of public keys: SHA-256 (32 bytes) for ipg-public-v1, SHA-384 (48 bytes) for P-384, P-384 plus ML-DSA-65 and hybrid identities",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Envelope",
      "@type": "ipg:Entity",
      "description": "Single-recipient authenticated encryption in the recipient's suite; does not identify a sender",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:Signature",
      "@type": "ipg:Entity",
      "description": "Detached Ed25519, low-s ECDSA P-384, composite Ed25519 plus ML-DSA-65, or composite ECDSA P-384 plus ML-DSA-65 signature over a framed signer fingerprint and content; both halves of a composite must verify",
