        "ic:ecdsa-p384-sha384",
        "ic:sha2-384",
        "ic:ml-dsa-65"
      ],
      "conditional_effects": [
        "load the host PKCS#11 module and log in to a token when key is a hardware reference",
        "open the host TPM and load wrapped keys when key is an ipg-tpm-key-v1 file",
        "call AWS KMS with host credentials over the network when key is an ipg-kms-key-v1 file"
      ],
      "constraints": [
        "ipg:constraint/identity-pin",
        "ipg:constraint/secret-channel",
        "ipg:constraint/no-clobber",
