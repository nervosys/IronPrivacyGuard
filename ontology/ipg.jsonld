      "steps": {
        "@list": [
          {
            "@id": "ipg:operation/key.revoke"
          },
          {
            "@id": "ipg:operation/trust.revoke"
          },
          {
            "@id": "ipg:operation/trust.status"
          }
        ]
      }
    },
    {
      "@id": "ipg:workflow/change-passphrase",
      "@type": "ipg:Workflow",
      "steps": {
        "@list": [
          {
            "@id": "ipg:operation/key.rewrap"
          },
          {
            "@id": "ipg:operation/key.public"
          }
