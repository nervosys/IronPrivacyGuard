{
  "@context": {
    "@vocab": "urn:ipg:v1:",
    "algorithms": {
      "@type": "@id"
    },
    "constraints": {
      "@type": "@id"
    },
    "goals": {
      "@type": "@id"
    },
    "ic": "urn:ironcrypto:algorithm:",
    "inputs": {
      "@type": "@id"
    },
    "ipg": "urn:ipg:v1:",
    "optional_inputs": {
      "@type": "@id"
    },
    "outputs": {
      "@type": "@id"
    },
    "sources": {
      "@type": "@id"
    },
    "tools": {
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "ipg:KnowledgeQuery",
      "@type": "ipg:Entity",
      "description": "1..256 Unicode characters with an alphanumeric token; deterministic keyword search",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KnowledgeBase",
      "@type": "ipg:Entity",
      "description": "Centralized curated application guidance and tool mappings",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KnowledgeSelection",
      "@type": "ipg:Entity",
      "description": "Deterministic keyword matches; not approval or authorization",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:CandidateRequest",
      "@type": "ipg:Entity",
      "description": "Untrusted JSON proposed as an IPG Request object; not a Call envelope",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:RequestValidation",
      "@type": "ipg:Entity",
      "description": "Static preflight issues with JSON Pointers; no authentication or authorization claim",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustComparison",
      "@type": "ipg:Entity",
      "description": "Ordered snapshot changes and structural extension compatibility; not approval or a freshness proof",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Validity",
      "@type": "ipg:Entity",
      "description": "Self-signed entire-identity half-open validity window [not_before, not_after)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:UnixTime",
      "@type": "ipg:Entity",
      "description": "Integer Unix seconds from 0 through 253402300799",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:ValidityVerification",
      "@type": "ipg:Entity",
      "description": "Authenticated validity evidence; does not apply policy",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TrustEvaluation",
      "@type": "ipg:Entity",
      "description": "Advisory permitted, revoked, not_yet_valid or expired at a supplied time",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:McpTransport",
      "@type": "ipg:Entity",
      "description": "Newline-delimited JSON-RPC stdio; initialize, initialized notification, ping, tools/list and tools/call",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:McpHostPolicy",
      "@type": "ipg:Entity",
      "description": "Startup-selected trust snapshot injected into encrypt, stream.encrypt, sign, stream.sign, verify and stream.verify, and optional hardware key custody requirement; tool callers cannot replace either",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TokenInventory",
      "@type": "ipg:Entity",
      "description": "Tokens visible through the host-configured PKCS#11 module with advertised mechanisms; advisory, no login",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TokenSerial",
      "@type": "ipg:Entity",
      "description": "PKCS#11 token serial number selecting exactly one present token",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KeyLabel",
      "@type": "ipg:Entity",
      "description": "CKA_LABEL of 1..64 bytes written to generated token objects; informational, never used for lookup",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KeyId",
      "@type": "ipg:Entity",
      "description": "PKCS#11 CKA_ID of 1..64 bytes identifying one key pair's public and private objects",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TokenPin",
      "@type": "ipg:Entity",
      "description": "Token user PIN, 1..255 exact file bytes; never a request value",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:KeyDeletion",
      "@type": "ipg:Entity",
      "description": "Confirmation that a TPM-backed identity's persisted keys were permanently deleted",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:StreamCiphertext",
      "@type": "ipg:Entity",
      "description": "ipg-stream-v1: a binary stream with a header wrapping one content key for each of 1..64 recipients and authenticated 64 KiB chunks; does not identify a sender",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:StreamSignature",
      "@type": "ipg:Entity",
      "description": "ipg-stream-signature-v1: detached signature binding the signer, algorithm, SHA-384 digest and u64 byte count of an any-size file; distinct from ordinary detached signatures and external prehash modes",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TpmEvidence",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-evidence-v1: the identity, the TPM's EK public area and certificates, its attestation key and two TPM2_Certify certifications; public, and not a proof until verified with a credential challenge",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TrustAnchors",
      "@type": "ipg:Entity",
      "description": "Root certificates (PEM or DER) of the TPM manufacturers the verifier accepts, chosen by the verifier",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TpmChallenge",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-challenge-v1: a credential encrypted to the TPM's endorsement key for the evidence's attestation key (software TPM2_MakeCredential)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:TpmChallengeSecret",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-challenge-secret-v1: the verifier's copy of the challenge credential; keep private and use once",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:TpmAttestationResponse",
      "@type": "ipg:Entity",
      "description": "ipg-tpm-response-v1: the credential the TPM released through TPM2_ActivateCredential",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AttestationReport",
      "@type": "ipg:Entity",
      "description": "What a verification established: EK certificate and anchor digests, TPM firmware, key attributes (fixedTPM, fixedParent, sensitiveDataOrigin) and whether the credential activation was verified",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:OpenpgpKeyFile",
      "@type": "ipg:Entity",
      "description": "ipg-openpgp-key-v1: a v4 or v6 OpenPGP key generated by IPG whose transferable secret key is sealed with Argon2id and ChaCha20-Poly1305; the certificate is public",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "ipg:OpenpgpCertificate",
      "@type": "ipg:Entity",
      "description": "An OpenPGP certificate (transferable public key) file, ASCII-armored or binary; untrusted until pinned by fingerprint",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:OpenpgpSecretKey",
      "@type": "ipg:Entity",
      "description": "Transferable OpenPGP private key, armored or binary; imports may be unprotected, exports always protect every secret packet; keep private",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:OpenpgpFingerprint",
      "@type": "ipg:Entity",
      "description": "OpenPGP primary-key fingerprint: v4 40 or v6 64 hexadecimal characters, either case; distinct from IPG fingerprints",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:OpenpgpUserId",
      "@type": "ipg:Entity",
      "description": "Self-asserted OpenPGP User ID label such as \"Alice <alice@example.org>\"; 1..256 bytes without control characters; never identity proof",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:OpenpgpMessage",
      "@type": "ipg:Entity",
      "description": "ASCII-armored or binary OpenPGP message; IPG writes armored AES-256 messages: SEIPDv1 for v4, SEIPDv2/OCB for v6",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:OpenpgpSignature",
      "@type": "ipg:Entity",
      "description": "Detached OpenPGP document signature, ASCII-armored or binary",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:OpenpgpCertificateReport",
      "@type": "ipg:Entity",
      "description": "A certificate evaluated under IPG policy at host time: per-key algorithm, flags, expiry, revocation, usability and issues",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:OpenpgpVerification",
      "@type": "ipg:Entity",
      "description": "A valid detached OpenPGP signature by a key of the pinned certificate that was valid for signing when it signed; no identity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:KmsKeyFile",
      "@type": "ipg:Entity",
      "description": "Public ipg-kms-key-v1 file binding an identity to AWS KMS key ARNs in one region: two P-384 keys (ipg-public-p384-v1), plus an ML_DSA_65 key for composite post-quantum signatures (ipg-public-p384-mldsa65-v1); using it needs host AWS credentials",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:AwsRegion",
      "@type": "ipg:Entity",
      "description": "AWS region holding both KMS keys, for example us-gov-west-1",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:KmsKeyArn",
      "@type": "ipg:Entity",
      "description": "Exact KMS key ARN; aliases are refused because they can be repointed",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TpmInventory",
      "@type": "ipg:Entity",
      "description": "Host TPM manufacturer, vendor, firmware, supported curves and owner-hierarchy readiness; advisory",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TpmKeyFile",
      "@type": "ipg:Entity",
      "description": "Host TPM key file for a P-384 identity: ipg-tpm-key-v1 (Linux and Windows) holds TPM-wrapped fixedTPM blobs only the originating TPM can load, so deleting every copy destroys the identity; legacy ipg-cng-key-v1 (Windows) names persisted Platform Crypto Provider keys, removed with tpm.key.delete",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "ipg:HardwareKeyReference",
      "@type": "ipg:Entity",
      "description": "Public ipg-pkcs11-key-v1 file binding a P-384 identity to token serial, label, manufacturer, model and two key IDs; holds no secret material",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:ToolAllowlist",
      "@type": "ipg:Entity",
      "description": "Host-selected IPG operation IDs exposed and callable in this MCP session; not a filesystem sandbox",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustStore",
      "@type": "ipg:Entity",
      "description": "Immutable snapshot of explicitly enrolled public identities and retained verified revocations with optional signed validity windows",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustDigest",
      "@type": "ipg:Entity",
      "description": "Externally pinned commitment to a canonical trust snapshot: SHA-384 for ipg-trust-v3, SHA-256 for legacy v1 and v2; not a signature or freshness proof",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustPolicy",
      "@type": "ipg:Entity",
      "description": "Explicit snapshot path and expected digest; requires enrollment, rejects retained revocations and enforces validity at host time",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:TrustStatus",
      "@type": "ipg:Entity",
      "description": "Revocation state in one pinned snapshot; false does not establish global active status",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Revocation",
      "@type": "ipg:Entity",
      "description": "A self-signed request to permanently stop using both keys of an identity; no trusted timestamp",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:RevocationReason",
      "@type": "ipg:Entity",
      "description": "Closed vocabulary: compromised, superseded, retired",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:RevocationVerification",
      "@type": "ipg:Entity",
      "description": "Authenticated certificate evidence; policy_applied is false and no trust state is changed",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Artifact",
      "@type": "ipg:Entity",
      "description": "A versioned native IPG JSON file or raw data",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Plaintext",
      "@type": "ipg:Entity",
      "description": "Exact binary content; never emitted in control responses",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:OpenpgpSourcePassword",
      "@type": "ipg:Entity",
      "description": "0..4096 exact file bytes for importing an external secret key; an empty file supports unprotected source packets",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:Passphrase",
      "@type": "ipg:Entity",
      "description": "16..4096 exact file bytes, including any newline",
      "sensitivity": "secret"
    },
    {
      "@id": "ipg:PublicKey",
      "@type": "ipg:Entity",
      "description": "Independent encryption and signing public keys bound by a fingerprint: X25519 and Ed25519 (ipg-public-v1), ML-KEM-768 plus X25519 with Ed25519 plus ML-DSA-65 (ipg-public-hybrid-v1), P-384 ECDH and ECDSA (ipg-public-p384-v1), or P-384 ECDH with ECDSA P-384 plus ML-DSA-65 (ipg-public-p384-mldsa65-v1)",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:SecretKey",
      "@type": "ipg:Entity",
      "description": "Software identity seeds protected by Argon2id and ChaCha20-Poly1305: 64 bytes (ipg-secret-v1) or 160 bytes including the ML-KEM-768 and ML-DSA-65 seeds (ipg-secret-hybrid-v1)",
      "sensitivity": "encrypted-secret"
    },
    {
      "@id": "ipg:Fingerprint",
      "@type": "ipg:Entity",
      "description": "Hash of a suite-specific domain-separated length-framed pair of public keys: SHA-256 (32 bytes) for ipg-public-v1, SHA-384 (48 bytes) for P-384, P-384 plus ML-DSA-65 and hybrid identities",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Envelope",
      "@type": "ipg:Entity",
      "description": "Single-recipient authenticated encryption in the recipient's suite; does not identify a sender",
      "sensitivity": "ciphertext"
    },
    {
      "@id": "ipg:Signature",
      "@type": "ipg:Entity",
      "description": "Detached Ed25519, low-s ECDSA P-384, composite Ed25519 plus ML-DSA-65, or composite ECDSA P-384 plus ML-DSA-65 signature over a framed signer fingerprint and content; both halves of a composite must verify",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Verification",
      "@type": "ipg:Entity",
      "description": "Valid signature for an externally pinned key; no external identity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Digest",
      "@type": "ipg:Entity",
      "description": "SHA-256 digest; no authenticity assertion",
      "sensitivity": "public"
    },
    {
      "@id": "ipg:Inspection",
      "@type": "ipg:Entity",
      "description": "Unauthenticated artifact metadata",
      "sensitivity": "untrusted"
    },
    {
      "@id": "ipg:Request",
      "@type": "ipg:Entity",
      "description": "Strict tagged operation with named parameters",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Plan",
      "@type": "ipg:Entity",
      "description": "Typed request-shape contract; semantic constraints and file authentication are not checked",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:CapabilityCatalog",
      "@type": "ipg:Entity",
      "description": "Executable operation inventory and runtime limits",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:AlgorithmCatalog",
      "@type": "ipg:Entity",
      "description": "Upstream IronCrypto ontology; presence does not enable an IPG suite",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Schema",
      "@type": "ipg:Entity",
      "description": "Generated JSON Schema including static input constraints; cryptographic and relational validation remains at runtime",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:Ontology",
      "@type": "ipg:Entity",
      "description": "Versioned JSON-LD graph of this implementation",
      "sensitivity": "control"
    },
    {
      "@id": "ipg:operation/knowledge",
      "@type": "ipg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "ipg:constraint/knowledge-advisory"
      ],
      "description": "Read the centralized cryptography application knowledgebase and selection ontology",
      "deterministic": true,
      "effects": [],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "knowledge",
      "inputs": [],
      "key_inputs": [],
      "mcp_tool": "ipg_knowledge",
      "optional_inputs": [],
      "outputs": [
        "ipg:KnowledgeBase"
      ],
      "request_schema": {
        "command": "ipg schema",
        "operation_const": "knowledge"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "ipg:operation/knowledge.search",
      "@type": "ipg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "ipg:constraint/knowledge-advisory"
      ],
      "description": "Find application guidance by keywords or application ID; advisory only, no execution",
      "deterministic": true,
      "effects": [],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "knowledge.search",
      "inputs": [
        "ipg:KnowledgeQuery"
      ],
      "key_inputs": [],
      "mcp_tool": "ipg_knowledge_search",
      "optional_inputs": [],
      "outputs": [
        "ipg:KnowledgeSelection"
      ],
      "request_schema": {
        "command": "ipg schema",
        "operation_const": "knowledge.search"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "ipg:operation/request.validate",
      "@type": "ipg:Operation",
      "algorithms": [],
      "conditional_effects": [],
      "constraints": [
        "ipg:constraint/preflight-only"
      ],
      "description": "Preflight candidate Request JSON without execution, filesystem access or authentication",
      "deterministic": true,
      "effects": [],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "request.validate",
      "inputs": [
        "ipg:CandidateRequest"
      ],
      "key_inputs": [],
      "mcp_tool": "ipg_request_validate",
      "optional_inputs": [],
      "outputs": [
        "ipg:RequestValidation"
      ],
      "request_schema": {
        "command": "ipg schema",
        "operation_const": "request.validate"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "ipg:operation/trust.compare",
      "@type": "ipg:Operation",
      "algorithms": [
        "ic:sha2-256",
        "ic:ed25519",
        "ic:ecdsa-p384-sha384",
        "ic:sha2-384",
        "ic:ml-dsa-65"
      ],
      "conditional_effects": [],
      "constraints": [
        "ipg:constraint/snapshot-policy",
        "ipg:constraint/snapshot-reconciliation"
      ],
      "description": "Compare two pinned snapshots without approving or publishing either",
      "deterministic": true,
      "effects": [
        "read_file"
      ],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "trust.compare",
      "inputs": [
        "ipg:TrustPolicy"
      ],
      "key_inputs": [],
      "mcp_tool": "ipg_trust_compare",
      "optional_inputs": [],
      "outputs": [
        "ipg:TrustComparison"
      ],
      "request_schema": {
        "command": "ipg schema",
        "operation_const": "trust.compare"
      },
      "retry": "Safe to retry if inputs are unchanged."
    },
    {
      "@id": "ipg:operation/trust.merge",
      "@type": "ipg:Operation",
      "algorithms": [
        "ic:sha2-256",
        "ic:ed25519",
        "ic:ecdsa-p384-sha384",
        "ic:sha2-384",
        "ic:ml-dsa-65"
      ],
      "conditional_effects": [],
      "constraints": [
        "ipg:constraint/snapshot-policy",
        "ipg:constraint/snapshot-reconciliation",
        "ipg:constraint/no-clobber"
      ],
      "description": "Reconcile two pinned snapshots, retaining revocations and nested validity restrictions",
      "deterministic": true,
      "effects": [
        "read_file",
        "create_file"
      ],
      "errors": [
        "invalid_request",
        "invalid_format",
        "limit_exceeded",
        "authentication_failed",
        "identity_mismatch",
        "key_not_trusted",
        "key_revoked",
        "key_expired",
        "key_not_yet_valid",
        "clock_unavailable",
        "merge_conflict",
        "policy_mismatch",
        "io_error",
        "already_exists",
        "entropy_unavailable",
        "provider_unavailable",
        "hardware_not_found",
        "mechanism_unsupported",
        "provider_error",
        "pin_locked"
      ],
      "id": "trust.merge",
      "inputs": [
        "ipg:TrustPolicy"
      ],
      "key_inputs": [],
      "mcp_tool": "ipg_trust_merge",
      "optional_inputs": [],
      "outputs": [
        "ipg:TrustStore",
        "ipg:TrustDigest"
      ],
      "request_schema": {
        "command": "ipg schema",
        "operation_const": "trust.merge"
      },
      "retry": "Do not retry blindly; inspect the destination after an ambiguous transport failure. Existing outputs are never replaced."
    },
    {
      "@id": "ipg:operation/key.validity",
      "@type": "ipg:Operation",
