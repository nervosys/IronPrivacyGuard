  "@graph": [
    {
      "@id": "ic:x25519",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Ephemeral sender key agreement with the recipient public key inside the native envelope suite",
      "label": "X25519",
      "limitations": [
        "Not encryption on its own",
        "Does not authenticate the sender",
        "Not post-quantum"
      ],
      "role": "Key agreement",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc7748"
      ]
    },
    {
      "@id": "ic:hkdf-sha2-256",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Derive the envelope encryption key from the X25519 shared secret with protocol context",
      "label": "HKDF-SHA-256",
      "limitations": [
        "Not a password-hardening function",
        "No standalone APG derivation command"
      ],
      "role": "Key derivation from keying material",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc5869"
      ]
    },
    {
      "@id": "ic:chacha20-poly1305",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Protect envelope plaintext and wrapped private seeds; authenticate before releasing plaintext",
      "label": "ChaCha20-Poly1305",
      "limitations": [
        "Nonce reuse under the same key is unsafe",
        "Ciphertext authentication is not proof of sender identity"
      ],
      "role": "Authenticated encryption with associated data",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8439"
      ]
    },
    {
      "@id": "ic:ed25519",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Domain-separated content signatures and signed identity lifecycle certificates",
      "label": "Ed25519",
      "limitations": [
        "No confidentiality",
        "Key identity needs an independent trust binding",
        "Not post-quantum"
      ],
      "role": "Digital signature",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8032"
      ]
    },
    {
      "@id": "ic:argon2id",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Derive private-key wrapping keys using the fixed APG v1 profile: 65536 KiB memory, 3 iterations, 4 lanes",
      "label": "Argon2id",
      "limitations": [
        "No APG password-verifier API",
        "APG profile is a protocol choice, not a universal password policy"
      ],
      "role": "Memory-hard password-based derivation",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106"
      ]
    },
    {
      "@id": "ic:sha2-256",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "File digests, apg-public-v1 fingerprints and legacy v1/v2 trust snapshot digests",
      "label": "SHA-256",
      "limitations": [
        "Unkeyed hashing does not prove origin",
        "Fast hashing is not password hardening"
      ],
      "role": "Cryptographic digest",
      "sources": []
    },
    {
      "@id": "ic:ecdh-p384",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Ephemeral sender key agreement with a P-384 identity; tokens run CKM_ECDH1_DERIVE, preferably with the X9.63 KDF so the shared secret never leaves them",
      "label": "ECDH P-384",
      "limitations": [
        "Not encryption on its own",
        "Does not authenticate the sender",
        "Not post-quantum",
        "Points must be validated uncompressed curve points"
      ],
      "role": "Key agreement",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-56Ar3"
      ]
    },
    {
      "@id": "ic:aes-256-gcm",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Protect P-384 envelope plaintext; authenticate before releasing plaintext",
      "label": "AES-256-GCM",
      "limitations": [
        "Nonce reuse under the same key is catastrophic",
        "Ciphertext authentication is not proof of sender identity"
      ],
      "role": "Authenticated encryption with associated data",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ]
    },
    {
      "@id": "ic:ecdsa-p384-sha384",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Hardware identity signatures, certificates and possession checks; tokens sign the SHA-384 digest with CKM_ECDSA and APG canonicalizes to low-s",
      "label": "ECDSA P-384 with SHA-384",
      "limitations": [
        "Randomized signatures differ per run",
        "Signatures are malleable unless low-s is enforced, which APG does",
        "Not post-quantum"
      ],
      "role": "Digital signature",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.186-5"
      ]
    },
    {
      "@id": "ic:sha2-384",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "P-384 and hybrid identity fingerprints, apg-trust-v3 snapshot digests, the message digest for ECDSA P-384 signatures, and the hash inside the P-384 envelope's ANSI X9.63 KDF (PKCS#11 CKD_SHA384_KDF) and its SharedInfo commitment",
      "label": "SHA-384",
      "limitations": [
        "No authenticity on its own",
        "Not a password-hardening function",
        "No standalone APG sha2-384 digest command"
      ],
      "role": "Cryptographic hash",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.180-4"
      ]
    },
    {
      "@id": "ic:ml-kem-768",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Encapsulates a second shared secret to hybrid identities; combined with X25519 by HKDF so either component alone protects the envelope",
      "label": "ML-KEM-768",
      "limitations": [
        "Encapsulation only, not encryption or authentication",
        "Marked experimental in IronCrypto; interoperability checked against PyCA and OpenSSL",
        "Not used for signatures"
      ],
      "role": "Post-quantum key encapsulation",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.203"
      ]
    },
    {
      "@id": "ic:ml-dsa-65",
      "@type": "apg:CryptographicPrimitive",
      "apg_usage": "Second half of composite ed25519-mldsa65 signatures and certificates for hybrid identities; hedged signing with a fixed APG context string",
      "label": "ML-DSA-65",
      "limitations": [
        "Used only in composite with Ed25519",
        "Marked experimental in IronCrypto; interoperability checked against PyCA and OpenSSL",
        "Large signatures (3309 bytes)"
      ],
      "role": "Post-quantum digital signature",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.204"
      ]
    },
    {
      "@id": "apg:application/confidential-file-transfer",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/confidentiality",
        "apg:goal/ciphertext-integrity"
      ],
      "guidance": "The envelope suite follows the recipient identity: X25519/ChaCha20-Poly1305 for apg-public-v1, P-384/AES-256-GCM for apg-public-p384-v1. Inspect discover limits before transferring data.",
      "id": "confidential-file-transfer",
      "keywords": [
        "encryption",
        "decryption",
        "confidentiality",
        "backup",
        "at rest",
        "X25519",
        "HKDF",
        "ChaCha20 Poly1305",
        "P-384",
        "AES-GCM"
      ],
      "label": "Encrypt and decrypt a file for one recipient",
      "limitations": [
        "One recipient and native APG format only; bounded in-memory files",
        "Encryption does not authenticate the sender",
        "No forward secrecy against later recipient private-key compromise",
        "Decryption remains available for recovery without trust policy enforcement"
      ],
      "prerequisites": [
        "Recipient public identity and independently trusted fingerprint",
        "Recipient secret key and passphrase file, or hardware key reference and PIN file, for decryption",
        "Supply a pinned trust policy to encrypt when revocation and expiry must be enforced"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8439",
        "https://www.rfc-editor.org/rfc/rfc7748",
        "https://www.rfc-editor.org/rfc/rfc5869",
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/encrypt",
        "apg:operation/decrypt"
      ]
    },
    {
      "@id": "apg:application/authenticate-file",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/content-authenticity",
        "apg:goal/content-integrity"
      ],
      "guidance": "Verify against the expected signer and exact original bytes before consuming content.",
      "id": "authenticate-file",
      "keywords": [
        "signature",
        "signing",
        "authenticity",
        "artifact",
        "release",
        "Ed25519",
        "ECDSA"
      ],
      "label": "Sign and verify exact file bytes",
      "limitations": [
        "Native detached APG signatures; no OpenPGP or platform code-signing compatibility",
        "No confidentiality, trusted timestamp, replay prevention or automatic authorization"
      ],
      "prerequisites": [
        "Signer secret key and passphrase, or hardware key reference and PIN file, for signing",
        "Public signer identity and independently trusted fingerprint for verification",
        "Supply a pinned policy for revocation and expiry enforcement"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8032",
        "https://doi.org/10.6028/NIST.FIPS.186-5"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/sign",
        "apg:operation/verify"
      ]
    },
    {
      "@id": "apg:application/file-digest",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/content-identification"
      ],
      "guidance": "Compare digests for byte identity; use sign and verify when signer authentication is needed.",
      "id": "file-digest",
      "keywords": [
        "hash",
        "checksum",
        "fingerprint",
        "deduplication",
        "sha256"
      ],
      "label": "Compute a SHA-256 file digest",
      "limitations": [
        "An unkeyed digest does not authenticate a sender",
        "Not a password storage or password derivation interface"
      ],
      "prerequisites": [
        "An independently authenticated expected digest if using the result to detect malicious substitution"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "apg:operation/hash"
      ]
    },
    {
      "@id": "apg:application/protect-private-identity",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/secret-protection"
      ],
      "guidance": "APG internally derives a wrapping key with Argon2id and encrypts private seeds; no raw KDF endpoint is exposed.",
      "id": "protect-private-identity",
      "keywords": [
        "key generation",
        "private key",
        "secret key",
        "password",
        "rewrap",
        "Argon2id"
      ],
      "label": "Create an identity and change its protective passphrase",
      "limitations": [
        "Rewrapping does not rotate the identity or invalidate old copies",
        "Host filesystem permissions and secret-file cleanup remain caller responsibilities"
      ],
      "prerequisites": [
        "Access-controlled passphrase file of 16..4096 bytes",
        "New destinations; APG never overwrites files",
        "Expected identity fingerprint when rewrapping"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106",
        "https://www.rfc-editor.org/rfc/rfc8439"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/key.generate",
        "apg:operation/key.public",
        "apg:operation/key.rewrap"
      ]
    },
    {
      "@id": "apg:application/manage-trust",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/identity-policy"
      ],
      "guidance": "Publish immutable snapshots and explicitly supply the approved pin to governed operations or MCP host configuration.",
      "id": "manage-trust",
      "keywords": [
        "trust",
        "policy",
        "enrollment",
        "allowlist",
        "compare",
        "merge"
      ],
      "label": "Enroll identities and reconcile trust snapshots",
      "limitations": [
        "Comparison and merge do not approve policy",
        "No automatic revocation distribution or rollback protection; retain latest digest externally"
      ],
      "prerequisites": [
        "Independently trusted identity fingerprints",
        "Externally pinned snapshot digests and explicit approval of newly produced snapshots"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "apg:operation/trust.init",
        "apg:operation/trust.add",
        "apg:operation/trust.status",
        "apg:operation/trust.compare",
        "apg:operation/trust.merge"
      ]
    },
    {
      "@id": "apg:application/revoke-identity",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/identity-policy"
      ],
      "guidance": "Import the authenticated certificate into a new snapshot, then distribute and explicitly adopt its digest.",
      "id": "revoke-identity",
      "keywords": [
        "revocation",
        "compromise",
        "retire",
        "incident"
      ],
      "label": "Revoke an identity and enforce the revocation",
      "limitations": [
        "Certificate creation or verification alone does not enforce revocation",
        "Existing ciphertext and signatures are not erased"
      ],
      "prerequisites": [
        "Identity private key and passphrase to self-revoke",
        "Pinned public identity and trust snapshot to import the certificate"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "apg:operation/key.revoke",
        "apg:operation/revocation.verify",
        "apg:operation/trust.revoke",
        "apg:operation/trust.status"
      ]
    },
    {
      "@id": "apg:application/identity-validity",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/identity-policy"
      ],
      "guidance": "Issue a signed window, import it into a snapshot, and apply that policy to encrypt, sign and verify.",
      "id": "identity-validity",
      "keywords": [
        "expiry",
        "expiration",
        "time",
        "validity",
        "schedule"
      ],
      "label": "Constrain an identity to a signed validity window",
      "limitations": [
        "trust.evaluate is advisory; caller-selected times never authorize execution",
        "Enforcement uses the host clock",
        "Validity imports can narrow existing windows only"
      ],
      "prerequisites": [
        "Signer secret key and passphrase",
        "Unix seconds with not_before strictly less than not_after",
        "Pinned policy adopted by governed operations"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "apg:operation/key.validity",
        "apg:operation/validity.verify",
        "apg:operation/trust.validity",
        "apg:operation/trust.evaluate"
      ]
    },
    {
      "@id": "apg:application/inspect-artifact",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/structural-validation"
      ],
      "guidance": "Use inspect to route an artifact, then explicitly invoke the appropriate authentication operation.",
      "id": "inspect-artifact",
      "keywords": [
        "inspect",
        "format",
        "metadata",
        "parse"
      ],
      "label": "Identify a native artifact and validate its structure",
      "limitations": [
        "Inspection does not authenticate the artifact or trust embedded metadata"
      ],
      "prerequisites": [
        "Bounded native APG artifact file"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "apg:operation/inspect"
      ]
    },
    {
      "@id": "apg:application/openpgp-interoperability",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/protocol-interoperability"
      ],
      "guidance": "Generate an OpenPGP key with openpgp.key.generate (algorithm p384 for CNSA-aligned deployments), share the certificate from openpgp.cert.export, and review correspondents' certificates with openpgp.cert.inspect before pinning their fingerprints. openpgp.encrypt accepts up to 32 recipients; decrypt and sign with the APG-held key; verify detached signatures with openpgp.verify.",
      "id": "openpgp-interoperability",
      "keywords": [
        "pgp",
        "gpg",
        "openpgp",
        "import",
        "email",
        "compatibility"
      ],
      "label": "Exchange OpenPGP messages or GPG keys",
      "limitations": [
        "Uses rPGP, not IronCrypto, for OpenPGP cryptography; the combination has not had independent review",
        "v4 keys only; APG generates Ed25519 or P-384 keys and cannot import or export OpenPGP secret keys",
        "Signatures embedded in messages are not verified; exchange detached signatures",
        "No web of trust, keyservers or designated revokers; certificates are pinned by fingerprint and APG trust snapshots do not apply",
        "Certificates using SHA-1 self-signatures, RSA below 2048 bits, DSA or ElGamal are rejected",
        "APG native envelopes, signatures and keys are never OpenPGP packets"
      ],
      "prerequisites": [
        "An apg build with the openpgp feature",
        "Each correspondent's OpenPGP certificate and its independently trusted 40-hex fingerprint",
        "An MCP host that pins a trust policy must name the openpgp operations in --allow"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9580",
        "https://github.com/rpgp/rpgp"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/openpgp.key.generate",
        "apg:operation/openpgp.cert.export",
        "apg:operation/openpgp.cert.inspect",
        "apg:operation/openpgp.encrypt",
        "apg:operation/openpgp.decrypt",
        "apg:operation/openpgp.sign",
        "apg:operation/openpgp.verify"
      ]
    },
    {
      "@id": "apg:application/secure-network-channel",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/channel-security"
      ],
      "guidance": "Use a complete transport protocol implementation; do not assemble a channel from APG file commands.",
      "id": "secure-network-channel",
      "keywords": [
        "tls",
        "https",
        "network",
        "transport",
        "channel",
        "session"
      ],
      "label": "Secure a live client-server connection",
      "limitations": [
        "APG file encryption is not a TLS handshake or record protocol"
      ],
      "prerequisites": [
        "A separately evaluated TLS stack and peer authentication policy"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8446"
      ],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "apg:application/password-verifier-storage",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/password-verification"
      ],
      "guidance": "Use a dedicated salted password verifier API; do not use APG hash or treat key wrapping as login verification.",
      "id": "password-verifier-storage",
      "keywords": [
        "password hashing",
        "password database",
        "login",
        "credential",
        "Argon2id"
      ],
      "label": "Store and verify user login passwords",
      "limitations": [
        "APG uses Argon2id internally but exposes no password verifier interface",
        "APG hash is a fast file digest, not password hashing"
      ],
      "prerequisites": [
        "A password hashing and verification implementation with application-specific resource policy"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106"
      ],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "apg:application/multi-recipient-encryption",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/confidentiality"
      ],
      "guidance": "For native APG envelopes, use a protocol designed for multiple recipients or encrypt separately to each recipient. For OpenPGP interoperability, openpgp.encrypt produces one message for up to 32 pinned certificates.",
      "id": "multi-recipient-encryption",
      "keywords": [
        "group",
        "multi recipient",
        "many recipients",
        "shared envelope"
      ],
      "label": "Encrypt one shared envelope for multiple recipients",
      "limitations": [
        "Native APG envelopes support exactly one recipient",
        "OpenPGP messages from openpgp.encrypt can have up to 32 recipients (see openpgp-interoperability)"
      ],
      "prerequisites": [
        "An implementation with an explicit multi-recipient format and policy"
      ],
      "sources": [],
      "support": "external_required",
      "tools": []
    },
    {
      "@id": "apg:application/post-quantum-protection",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/post-quantum-security",
        "apg:goal/confidentiality"
      ],
      "guidance": "Create a hybrid identity with apg key generate --identity apg-public-hybrid-v1. Encryption to that identity then always uses the hybrid envelope suite; there is no negotiation or fallback.",
      "id": "post-quantum-protection",
      "keywords": [
        "post quantum",
        "pqc",
        "quantum resistant",
        "harvest now decrypt later",
        "ml kem",
        "kyber",
        "hybrid",
        "encryption"
      ],
      "label": "Hybrid post-quantum encryption against future quantum attacks",
      "limitations": [
        "Fingerprints and trust-snapshot digests use SHA-384; signatures are composite Ed25519 plus ML-DSA-65 (see quantum-resistant-signing)",
        "Envelopes stay secure only while ML-KEM-768 or X25519 is unbroken; the combination has not had independent review",
        "IronCrypto's ML-KEM is marked experimental upstream; APG checks it against PyCA and OpenSSL only",
        "Software secret keys only; hardware identities have no post-quantum suite"
      ],
      "prerequisites": [
        "Generate the recipient with key.generate identity apg-public-hybrid-v1",
        "Recipient hybrid public identity and independently trusted fingerprint"
      ],
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.203",
        "https://www.rfc-editor.org/rfc/rfc7748",
        "https://www.rfc-editor.org/rfc/rfc5869"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/key.generate",
        "apg:operation/key.public",
        "apg:operation/encrypt",
        "apg:operation/decrypt"
      ]
    },
    {
      "@id": "apg:application/quantum-resistant-signing",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/quantum-resistant-authenticity"
      ],
      "guidance": "Sign with a hybrid identity; every signature, revocation and validity certificate then requires both Ed25519 and ML-DSA-65 to verify, so it stays unforgeable while either holds.",
      "id": "quantum-resistant-signing",
      "keywords": [
        "pq signing",
        "quantum resistant signing",
        "ml dsa",
        "dilithium",
        "composite signing"
      ],
      "label": "Require quantum-resistant signing",
      "limitations": [
        "Composite ed25519-mldsa65 only; no SLH-DSA or standalone ML-DSA",
        "Software keys only; PKCS#11, TPM and KMS identities sign with ECDSA P-384",
        "IronCrypto's ML-DSA is marked experimental upstream; APG checks it against PyCA and OpenSSL",
        "Signatures are about 3.4 KB and not interoperable with other composite-signature formats"
      ],
      "prerequisites": [
        "A hybrid identity from key.generate identity apg-public-hybrid-v1",
        "The signer's hybrid public identity and independently trusted fingerprint"
      ],
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.204"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/key.generate",
        "apg:operation/sign",
        "apg:operation/verify"
      ]
    },
    {
      "@id": "apg:application/hardware-key-custody",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/hardware-custody"
      ],
      "guidance": "Create the identity on a token with hardware.key.generate, bind vendor-generated keys with hardware.key.bind, or create TPM keys with tpm.key.generate; then use the resulting file as the key input. MCP hosts can add --key-custody hardware to refuse software keys.",
      "id": "hardware-key-custody",
      "keywords": [
        "hardware",
        "hsm",
        "token",
        "smartcard",
        "pkcs11",
        "cryptoki",
        "tpm",
        "trusted platform module",
        "non exportable",
        "P-384",
        "ECDSA",
        "ECDH"
      ],
      "label": "Keep private keys in a hardware token or HSM",
      "limitations": [
        "P-384 identities only; APG never substitutes another curve",
        "Tokens supporting CKD_SHA384_KDF and CKM_AES_GCM decrypt entirely in-token; others, TPMs and KMS release one per-envelope ECDH shared secret into process memory",
        "Protection flags are self-reported token attributes, not vendor attestation; counterparties cannot see custody",
        "The module runs inside the APG process with its privileges",
        "No token PIN, object or policy administration",
        "TPM key files are the only copy of the wrapped keys and load only in the originating TPM; tpm2-pkcs11 tokens lack ECDH and cannot decrypt through PKCS#11"
      ],
      "prerequisites": [
        "PKCS#11: an apg build with the pkcs11 feature, host-set APG_PKCS11_MODULE, and a token supporting P-384 with CKM_EC_KEY_PAIR_GEN, CKM_ECDSA and CKM_ECDH1_DERIVE",
        "TPM: an apg build with the tpm feature and a TPM 2.0 supporting P-384; on Linux also host-set APG_TPM_TCTI and an owner hierarchy with empty authorization, on Windows the Microsoft Platform Crypto Provider",
        "PIN in an access-controlled file"
      ],
      "sources": [
        "https://docs.oasis-open.org/pkcs11/pkcs11-spec/v3.1/pkcs11-spec-v3.1.html",
        "https://trustedcomputinggroup.org/resource/tpm-library-specification/",
        "https://doi.org/10.6028/NIST.FIPS.186-5",
        "https://doi.org/10.6028/NIST.SP.800-56Ar3"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/hardware.tokens",
        "apg:operation/hardware.key.generate",
        "apg:operation/hardware.key.bind",
        "apg:operation/tpm.info",
        "apg:operation/tpm.key.generate",
        "apg:operation/tpm.key.delete",
        "apg:operation/key.public",
        "apg:operation/decrypt",
        "apg:operation/sign",
        "apg:operation/key.revoke",
        "apg:operation/key.validity"
      ]
    },
    {
      "@id": "apg:application/managed-kms-custody",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/service-custody"
      ],
      "guidance": "Create the two KMS keys in infrastructure code, bind them with kms.key.bind, and use the resulting file as the key without passphrase_file. Set APG_KMS_FIPS=1 for FIPS endpoints. MCP hosts can add --key-custody non-exportable.",
      "id": "managed-kms-custody",
      "keywords": [
        "aws kms",
        "kms",
        "cloud key",
        "managed key",
        "key management service",
        "govcloud"
      ],
      "label": "Keep private keys in a cloud key management service",
      "limitations": [
        "AWS KMS only; APG never creates KMS keys",
        "SSO profiles need a current `aws sso login`; APG never refreshes SSO tokens",
        "Every private-key operation is a billable network call to AWS",
        "Decryption releases one per-envelope shared secret into process memory"
      ],
      "prerequisites": [
        "An apg build with the kms feature",
        "Host AWS credentials allowed kms:GetPublicKey, kms:Sign and kms:DeriveSharedSecret",
        "One ECC_NIST_P384 KEY_AGREEMENT key and one ECC_NIST_P384 SIGN_VERIFY key, created with infrastructure tooling"
      ],
      "sources": [
        "https://docs.aws.amazon.com/kms/latest/APIReference/API_DeriveSharedSecret.html",
        "https://docs.aws.amazon.com/kms/latest/APIReference/API_Sign.html",
        "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_sigv.html"
      ],
      "support": "implemented",
      "tools": [
        "apg:operation/kms.key.bind",
        "apg:operation/key.public",
        "apg:operation/decrypt",
        "apg:operation/sign",
        "apg:operation/key.revoke",
        "apg:operation/key.validity"
      ]
    },
    {
      "@id": "apg:application/validated-cryptographic-module",
      "@type": "apg:CryptographicApplication",
      "goals": [
        "apg:goal/validated-module"
      ],
      "guidance": "Do not infer validation from an algorithm name; APG has no validated mode. Hardware identities keep private-key operations in the PKCS#11 module, whose own validation status and approved-mode configuration must be verified separately.",
      "id": "validated-cryptographic-module",
      "keywords": [
        "fips",
        "validated",
        "compliance",
        "certified"
      ],
      "label": "Require a FIPS-validated cryptographic module",
      "limitations": [
        "APG makes no FIPS validation claim",
        "Outside in-token decryption, the envelope KDF and AES-GCM for hardware identities run in IronCrypto, which holds no CMVP certificate"
      ],
      "prerequisites": [
        "Independent verification of the required module validation and exact deployment configuration"
      ],
      "sources": [],
      "support": "external_required",
      "tools": []
    },
