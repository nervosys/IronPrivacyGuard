  "@graph": [
    {
      "@id": "ic:x25519",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Ephemeral sender key agreement with the recipient public key inside the native envelope suite",
      "label": "X25519",
      "limitations": [
        "Not encryption on its own",
        "Does not authenticate the sender",
        "Not post-quantum"
      ],
      "role": "Key agreement",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc7748"
      ]
    },
    {
      "@id": "ic:hkdf-sha2-256",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Derive the envelope encryption key from the X25519 shared secret with protocol context",
      "label": "HKDF-SHA-256",
      "limitations": [
        "Not a password-hardening function",
        "No standalone IPG derivation command"
      ],
      "role": "Key derivation from keying material",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc5869"
      ]
    },
    {
      "@id": "ic:chacha20-poly1305",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Protect envelope plaintext and wrapped private seeds; authenticate before releasing plaintext",
      "label": "ChaCha20-Poly1305",
      "limitations": [
        "Nonce reuse under the same key is unsafe",
        "Ciphertext authentication is not proof of sender identity"
      ],
      "role": "Authenticated encryption with associated data",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8439"
      ]
    },
    {
      "@id": "ic:ed25519",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Domain-separated content signatures and signed identity lifecycle certificates",
      "label": "Ed25519",
      "limitations": [
        "No confidentiality",
        "Key identity needs an independent trust binding",
        "Not post-quantum"
      ],
      "role": "Digital signature",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8032"
      ]
    },
    {
      "@id": "ic:argon2id",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Derive private-key wrapping keys using the fixed IPG v1 profile: 65536 KiB memory, 3 iterations, 4 lanes",
      "label": "Argon2id",
      "limitations": [
        "No IPG password-verifier API",
        "IPG profile is a protocol choice, not a universal password policy"
      ],
      "role": "Memory-hard password-based derivation",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106"
      ]
    },
    {
      "@id": "ic:sha2-256",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "File digests, ipg-public-v1 fingerprints and legacy v1/v2 trust snapshot digests",
      "label": "SHA-256",
      "limitations": [
        "Unkeyed hashing does not prove origin",
        "Fast hashing is not password hardening"
      ],
      "role": "Cryptographic digest",
      "sources": []
    },
    {
      "@id": "ic:ecdh-p384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Ephemeral sender key agreement with a P-384 identity; tokens run CKM_ECDH1_DERIVE, preferably with the X9.63 KDF so the shared secret never leaves them",
      "label": "ECDH P-384",
      "limitations": [
        "Not encryption on its own",
        "Does not authenticate the sender",
        "Not post-quantum",
        "Points must be validated uncompressed curve points"
      ],
      "role": "Key agreement",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-56Ar3"
      ]
    },
    {
      "@id": "ic:aes-256-gcm",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Protect P-384 envelope plaintext; authenticate before releasing plaintext",
      "label": "AES-256-GCM",
      "limitations": [
        "Nonce reuse under the same key is catastrophic",
        "Ciphertext authentication is not proof of sender identity"
      ],
      "role": "Authenticated encryption with associated data",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ]
    },
    {
      "@id": "ic:ecdsa-p384-sha384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Hardware identity signatures, certificates and possession checks; tokens sign the SHA-384 digest with CKM_ECDSA and IPG canonicalizes to low-s",
      "label": "ECDSA P-384 with SHA-384",
      "limitations": [
        "Randomized signatures differ per run",
        "Signatures are malleable unless low-s is enforced, which IPG does",
        "Not post-quantum"
      ],
      "role": "Digital signature",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.186-5"
      ]
    },
    {
      "@id": "ic:sha2-384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "P-384 and hybrid identity fingerprints, ipg-trust-v3 snapshot digests, the message digest for ECDSA P-384 signatures, and the hash inside the P-384 envelope's ANSI X9.63 KDF (PKCS#11 CKD_SHA384_KDF) and its SharedInfo commitment",
      "label": "SHA-384",
      "limitations": [
        "No authenticity on its own",
        "Not a password-hardening function",
        "No standalone IPG sha2-384 digest command"
      ],
      "role": "Cryptographic hash",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.180-4"
      ]
    },
    {
      "@id": "ic:ml-kem-768",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Encapsulates a second shared secret to hybrid identities; combined with X25519 by HKDF so either component alone protects the envelope",
      "label": "ML-KEM-768",
      "limitations": [
        "Encapsulation only, not encryption or authentication",
        "Marked experimental in IronCrypto; interoperability checked against PyCA and OpenSSL",
        "Not used for signatures"
      ],
      "role": "Post-quantum key encapsulation",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.203"
      ]
    },
    {
      "@id": "ic:ml-dsa-65",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Second half of composite ed25519-mldsa65 signatures and certificates for hybrid identities; hedged signing with a fixed IPG context string",
      "label": "ML-DSA-65",
      "limitations": [
        "Used only in composite with Ed25519",
        "Marked experimental in IronCrypto; interoperability checked against PyCA and OpenSSL",
        "Large signatures (3309 bytes)"
      ],
      "role": "Post-quantum digital signature",
      "sources": [
        "https://doi.org/10.6028/NIST.FIPS.204"
      ]
    },
    {
      "@id": "ic:shamir-gf256",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Splits a random 32-byte ChaCha20-Poly1305 key into k-of-n backup shares; the protected file is sealed under that key so recovery is authenticated",
      "label": "Shamir secret sharing over GF(2^8)",
      "limitations": [
        "Shares have no integrity of their own; IPG relies on the AEAD to detect wrong or insufficient shares",
        "Any k shares recover the key",
        "Not threshold signing or decryption: the key is reassembled in one place"
      ],
      "role": "Threshold secret sharing",
      "sources": [
        "https://dl.acm.org/doi/10.1145/359168.359176"
      ]
    },
    {
      "@id": "ic:hpke-x25519-sha256",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "MLS EncryptWithLabel for Welcome group secrets and UpdatePath path secrets, and DeriveKeyPair for ratchet tree node keys",
      "label": "HPKE (DHKEM(X25519, HKDF-SHA256), base mode)",
      "limitations": [
        "Base mode does not authenticate the sender; MLS signs and confirms what it encrypts",
        "X25519 only: no post-quantum protection for MLS groups"
      ],
      "role": "Public-key encryption to a recipient key",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9180"
      ]
    },
    {
      "@id": "ic:aes-128-gcm",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "MLS cipher suite 1 message, sender-data and Welcome protection",
      "label": "AES-128-GCM",
      "limitations": [
        "128-bit key; MLS suite 3 with ChaCha20-Poly1305 is IPG's default",
        "Nonce reuse is catastrophic; MLS ratchets and reuse guards prevent it"
      ],
      "role": "Authenticated encryption",
      "sources": [
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ]
    },
    {
      "@id": "ic:hpke-p384-sha384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "MLS cipher suite 7: EncryptWithLabel for Welcome group secrets and UpdatePath path secrets, and DeriveKeyPair for ratchet tree node keys",
      "label": "HPKE (DHKEM(P-384, HKDF-SHA384), base mode)",
      "limitations": [
        "Base mode does not authenticate the sender; MLS signs and confirms what it encrypts",
        "Built from FIPS-approved primitives, but DHKEM's labeled extract is not an SP 800-56C KDF, so the scheme is not FIPS-approved",
        "Not post-quantum"
      ],
      "role": "Public-key encryption to a recipient key",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9180",
        "https://www.rfc-editor.org/rfc/rfc9420"
      ]
    },
    {
      "@id": "ic:hkdf-sha2-384",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "The MLS cipher suite 7 key schedule, secret tree and labeled expansions",
      "label": "HKDF-SHA-384",
      "limitations": [
        "Not a password-hardening function",
        "No standalone IPG derivation command"
      ],
      "role": "Key derivation from keying material",
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc5869"
      ]
    },
    {
      "@id": "ic:pbkdf2-hmac-sha2-512",
      "@type": "ipg:CryptographicPrimitive",
      "ipg_usage": "Seal MLS group state and KeyPackage secrets under the FIPS algorithm policy, at 600,000 iterations with AES-256-GCM",
      "label": "PBKDF2-HMAC-SHA-512",
      "limitations": [
        "Not memory-hard: weaker than Argon2id against GPU guessing, so passphrases must be long and random",
        "Used only under the FIPS algorithm policy"
      ],
      "role": "Password-based key derivation (SP 800-132)",
      "sources": [
        "https://csrc.nist.gov/pubs/sp/800/132/final",
        "https://www.rfc-editor.org/rfc/rfc8018"
      ]
    },
    {
      "@id": "ipg:application/confidential-file-transfer",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality",
        "ipg:goal/ciphertext-integrity"
      ],
      "guidance": "The envelope suite follows the recipient identity: X25519/ChaCha20-Poly1305 for ipg-public-v1, P-384/AES-256-GCM for ipg-public-p384-v1. Inspect discover limits before transferring data.",
      "id": "confidential-file-transfer",
      "keywords": [
        "encryption",
        "decryption",
        "confidentiality",
        "backup",
        "at rest",
        "X25519",
        "HKDF",
        "ChaCha20 Poly1305",
        "P-384",
        "AES-GCM"
      ],
      "label": "Encrypt and decrypt a file for one recipient",
      "limitations": [
        "One recipient and native IPG format only; bounded in-memory files",
        "Encryption does not authenticate the sender",
        "No forward secrecy against later recipient private-key compromise",
        "Decryption remains available for recovery without trust policy enforcement"
      ],
      "prerequisites": [
        "Recipient public identity and independently trusted fingerprint",
        "Recipient secret key and passphrase file, or hardware key reference and PIN file, for decryption",
        "Supply a pinned trust policy to encrypt when revocation and expiry must be enforced"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8439",
        "https://www.rfc-editor.org/rfc/rfc7748",
        "https://www.rfc-editor.org/rfc/rfc5869",
        "https://doi.org/10.6028/NIST.SP.800-38D"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/encrypt",
        "ipg:operation/decrypt"
      ]
    },
    {
      "@id": "ipg:application/authenticate-file",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity",
        "ipg:goal/content-integrity"
      ],
      "guidance": "Verify against the expected signer and exact original bytes before consuming content. Use stream.sign and stream.verify beyond the in-memory limit; their separate native format signs a SHA-384 commitment and byte count with bounded memory.",
      "id": "authenticate-file",
      "keywords": [
        "signature",
        "signing",
        "authenticity",
        "artifact",
        "release",
        "Ed25519",
        "ECDSA"
      ],
      "label": "Sign and verify exact file bytes",
      "limitations": [
        "Native detached IPG signatures; no OpenPGP or platform code-signing compatibility",
        "No confidentiality, trusted timestamp, replay prevention or automatic authorization"
      ],
      "prerequisites": [
        "Signer secret key and passphrase, or hardware key reference and PIN file, for signing",
        "Public signer identity and independently trusted fingerprint for verification",
        "Supply a pinned policy for revocation and expiry enforcement"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8032",
        "https://doi.org/10.6028/NIST.FIPS.186-5"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/sign",
        "ipg:operation/verify",
        "ipg:operation/stream.sign",
        "ipg:operation/stream.verify"
      ]
    },
    {
      "@id": "ipg:application/file-digest",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-identification"
      ],
      "guidance": "Compare digests for byte identity; use sign and verify when signer authentication is needed.",
      "id": "file-digest",
      "keywords": [
        "hash",
        "checksum",
        "fingerprint",
        "deduplication",
        "sha256"
      ],
      "label": "Compute a SHA-256 file digest",
      "limitations": [
        "An unkeyed digest does not authenticate a sender",
        "Not a password storage or password derivation interface"
      ],
      "prerequisites": [
        "An independently authenticated expected digest if using the result to detect malicious substitution"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/hash"
      ]
    },
    {
      "@id": "ipg:application/protect-private-identity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/secret-protection"
      ],
      "guidance": "IPG internally derives a wrapping key with Argon2id and encrypts private seeds; no raw KDF endpoint is exposed.",
      "id": "protect-private-identity",
      "keywords": [
        "key generation",
        "private key",
        "secret key",
        "password",
        "rewrap",
        "Argon2id"
      ],
      "label": "Create an identity and change its protective passphrase",
      "limitations": [
        "Rewrapping does not rotate the identity or invalidate old copies",
        "Host filesystem permissions and secret-file cleanup remain caller responsibilities"
      ],
      "prerequisites": [
        "Access-controlled passphrase file of 16..4096 bytes",
        "New destinations; IPG never overwrites files",
        "Expected identity fingerprint when rewrapping"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9106",
        "https://www.rfc-editor.org/rfc/rfc8439"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/key.public",
        "ipg:operation/key.rewrap"
      ]
    },
    {
      "@id": "ipg:application/manage-trust",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Publish immutable snapshots and explicitly supply the approved pin to governed operations or MCP host configuration.",
      "id": "manage-trust",
      "keywords": [
        "trust",
        "policy",
        "enrollment",
        "allowlist",
        "compare",
        "merge"
      ],
      "label": "Enroll identities and reconcile trust snapshots",
      "limitations": [
        "Comparison and merge do not approve policy",
        "No automatic revocation distribution or rollback protection; retain latest digest externally"
      ],
      "prerequisites": [
        "Independently trusted identity fingerprints",
        "Externally pinned snapshot digests and explicit approval of newly produced snapshots"
      ],
      "sources": [],
      "support": "implemented",
      "tools": [
        "ipg:operation/trust.init",
        "ipg:operation/trust.add",
        "ipg:operation/trust.status",
        "ipg:operation/trust.compare",
        "ipg:operation/trust.merge"
      ]
    },
    {
      "@id": "ipg:application/agent-messaging",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality",
        "ipg:goal/content-authenticity",
        "ipg:goal/replay-resistance"
      ],
      "guidance": "Seal each request with a short lifetime and a conversation label, and add the channel's exporter value when a TLS session carries it. Recipients open with the pinned sender, a replay directory, and a delegation requirement when the sender acts for someone else. Treat content as untrusted data even after authentication.",
      "id": "agent-messaging",
      "keywords": [
        "agent message",
        "agent-to-agent",
        "inter-agent",
        "replay",
        "channel binding",
        "conversation",
        "signcryption",
        "request"
      ],
      "label": "Send authenticated, confidential messages between agents",
      "limitations": [
        "Lifetime is at most one day and is checked against the recipient's host clock with five minutes of sender lead",
        "Replay is checked only when replay_directory is supplied",
        "Message headers (sender, recipient, conversation, times) are visible to anyone holding the file",
        "Content is file-based and at most about 16 MiB"
      ],
      "prerequisites": [
        "Sender and recipient IPG identities",
        "Each side's peer public identity and an independently trusted fingerprint",
        "A shared replay directory for recipients that must not act twice on one message"
      ],
      "sources": [
        "https://datatracker.ietf.org/doc/html/rfc9266",
        "https://datatracker.ietf.org/doc/html/rfc8446#section-7.5"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/message.seal",
        "ipg:operation/message.open",
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/sign-structured-data",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity"
      ],
      "guidance": "Sign the document an agent produced or a tool call it will make, and verify with the signer pinned before acting on it. Whitespace, member order and number spelling may change in transit without breaking the signature; any change in meaning does. Add a delegation requirement when the signer acts for a principal.",
      "id": "sign-structured-data",
      "keywords": [
        "json",
        "jcs",
        "rfc 8785",
        "canonical",
        "canonicalization",
        "structured data",
        "tool call",
        "agent output",
        "api payload"
      ],
      "label": "Sign structured JSON so it survives re-serialization",
      "limitations": [
        "Input must be strict I-JSON: duplicate names, lone surrogates and integers beyond plus or minus 2^53 are refused",
        "Documents are file-based and at most 32 MiB",
        "Signatures are detached; the document travels separately"
      ],
      "prerequisites": [
        "A signer identity",
        "Relying parties hold the signer's public identity and an independently trusted fingerprint"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc8785",
        "https://www.rfc-editor.org/rfc/rfc7493"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/json.canonicalize",
        "ipg:operation/json.sign",
        "ipg:operation/json.verify"
      ]
    },
    {
      "@id": "ipg:application/agent-action-provenance",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity",
        "ipg:goal/provenance"
      ],
      "guidance": "Attest each consequential action with the outputs as subjects, the inputs as materials, a short action label and the grant's purpose. Verifiers pin the agent, check every artifact they will use, require the expected action, and add a delegation requirement so only authorized agents' statements count.",
      "id": "agent-action-provenance",
      "keywords": [
        "provenance",
        "in-toto",
        "dsse",
        "supply chain",
        "slsa",
        "agent action",
        "build",
        "produced",
        "materials"
      ],
      "label": "Record verifiable provenance of agent actions",
      "limitations": [
        "A statement is the agent's signed claim, not proof the action happened as described",
        "Digests are SHA-384 only; other algorithms in foreign statements are ignored",
        "Ed25519 and ECDSA P-384 envelopes verify with standard DSSE tooling; composite post-quantum signatures need IPG",
        "At most 64 subjects and 64 materials"
      ],
      "prerequisites": [
        "The acting agent's identity",
        "Relying parties hold the agent's public identity and an independently trusted fingerprint",
        "The artifact files to check against the statement"
      ],
      "sources": [
        "https://github.com/in-toto/attestation/blob/main/spec/v1/statement.md",
        "https://github.com/secure-systems-lab/dsse/blob/master/protocol.md",
        "https://slsa.dev/spec/v1.0/"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/provenance.attest",
        "ipg:operation/provenance.verify",
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/mls-agent-groups",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/confidentiality",
        "ipg:goal/content-authenticity",
        "ipg:goal/forward-secrecy"
      ],
      "guidance": "Have each agent publish a KeyPackage, add agents with mls.commit using their pinned fingerprints, and deliver every commit to every member in order. Use mls.process for each received message and compare epoch authenticators out of band when stakes are high. Commit regularly (an empty commit refreshes the sender) for post-compromise security.",
      "id": "mls-agent-groups",
      "keywords": [
        "mls",
        "rfc 9420",
        "group chat",
        "group encryption",
        "ratchet tree",
        "multi-agent",
        "swarm",
        "forward secrecy",
        "post-compromise"
      ],
      "label": "Run an end-to-end encrypted group of agents with MLS",
      "limitations": [
        "Cipher suites 1 and 3 only: X25519, not post-quantum",
        "No external commits or ReInit",
        "State files are replaced in place; keep no stale copies",
        "The delivery service must order commits; concurrent commits fork the group"
      ],
      "prerequisites": [
        "An IPG identity per agent",
        "Pinned fingerprints of agents to add",
        "A delivery channel that gives every member each commit in order"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9420",
        "https://www.rfc-editor.org/rfc/rfc9750"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/mls.key_package",
        "ipg:operation/mls.group.create",
        "ipg:operation/mls.commit",
        "ipg:operation/mls.join",
        "ipg:operation/mls.encrypt",
        "ipg:operation/mls.process",
        "ipg:operation/mls.status",
        "ipg:operation/mls.export"
      ]
    },
    {
      "@id": "ipg:application/threshold-backup",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/availability",
        "ipg:goal/confidentiality"
      ],
      "guidance": "Split an already passphrase-protected key file so recovery still needs the passphrase. Give each share to a different custodian or location, record the set ID, and test recovery with backup.combine. Re-split and destroy old shares when custodians change.",
      "id": "threshold-backup",
      "keywords": [
        "backup",
        "shamir",
        "secret sharing",
        "threshold",
        "k-of-n",
        "recovery",
        "escrow",
        "custodians"
      ],
      "label": "Back up a key so k of n custodians can recover it",
      "limitations": [
        "Any k custodians together can recover the file",
        "Every share reveals the protected file's length",
        "At most 16 shares and 1 MiB per backup",
        "Shares are not signed: authenticity comes from recovering the sealed file, not from who held a share"
      ],
      "prerequisites": [
        "The file to protect, preferably a passphrase-protected key",
        "n custodians who store their shares separately"
      ],
      "sources": [
        "https://dl.acm.org/doi/10.1145/359168.359176"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/backup.split",
        "ipg:operation/backup.combine"
      ]
    },
    {
      "@id": "ipg:application/rotate-identity",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/identity-policy"
      ],
      "guidance": "Generate the successor, run key.rotate with both keys and publish the statement. Relying parties run rotation.verify from their pinned fingerprint, check trust snapshots for revocations, then pin the new fingerprint with trust.add. Revoke the old key once peers have moved.",
      "id": "rotate-identity",
      "keywords": [
        "rotation",
        "rotate",
        "key rollover",
        "successor",
        "key update",
        "rekey",
        "migrate key"
      ],
      "label": "Rotate an identity to a successor key",
      "limitations": [
        "Not revocation: the previous key stays valid until revoked or expired",
        "Proves nothing if the previous key was compromised; revoke instead",
        "Chains of at most 16 statements"
      ],
      "prerequisites": [
        "Both the current and the successor private keys",
        "Relying parties hold a pinned fingerprint of an identity earlier in the chain"
      ],
      "sources": [
        "https://csrc.nist.gov/pubs/sp/800/57/pt1/r5/final"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/key.generate",
        "ipg:operation/key.rotate",
        "ipg:operation/rotation.verify",
        "ipg:operation/trust.add"
      ]
    },
    {
      "@id": "ipg:application/tamper-evident-audit",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/integrity",
        "ipg:goal/accountability"
      ],
      "guidance": "Start MCP hosts with --audit-log so every tool call is recorded before and after it runs. Checkpoint the log regularly with a separate identity and hand checkpoints to another party or agent. Verify with every checkpoint you hold; treat unanchored_entries as unprotected.",
      "id": "tamper-evident-audit",
      "keywords": [
        "audit",
        "audit log",
        "tamper-evident",
        "hash chain",
        "append-only",
        "transparency",
        "forensics",
        "accountability"
      ],
      "label": "Keep a tamper-evident audit log of agent activity",
      "limitations": [
        "Anyone who can write the file can append events; checkpoints attribute history, not individual events",
        "Entries after the latest checkpoint can be truncated undetectably",
        "Writers coordinate through a <log>.lock file; a crashed writer leaves it behind",
        "At most 64 KiB per event and 1 GiB per log"
      ],
      "prerequisites": [
        "A writable log file on the host",
        "A checkpoint signer identity whose public identity verifiers pin",
        "Somewhere the log holder cannot rewrite to keep checkpoints"
      ],
      "sources": [
        "https://www.rfc-editor.org/rfc/rfc9162",
        "https://www.usenix.org/legacy/event/sec09/tech/full_papers/crosby.pdf"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/audit.init",
        "ipg:operation/audit.append",
        "ipg:operation/audit.checkpoint",
        "ipg:operation/audit.verify"
      ]
    },
    {
      "@id": "ipg:application/quorum-approval",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/content-authenticity",
        "ipg:goal/separation-of-duties"
      ],
      "guidance": "Have approvers sign the exact plan (rfc8785 for JSON) with a narrow action label and short lifetime. The executing agent runs quorum.verify with the pinned approver set, threshold and a trust snapshot, and proceeds only when it succeeds. Treat rejected approvals as signals to investigate, never as approvals to retry with lower thresholds.",
      "id": "quorum-approval",
      "keywords": [
        "quorum",
        "threshold",
        "m-of-n",
        "multi-party approval",
        "two-person rule",
        "human in the loop",
        "sign-off",
        "consensus"
      ],
      "label": "Require m-of-n approvals before an agent acts",
      "limitations": [
        "Approvals last at most seven days and are checked at the verifier's host clock",
        "Up to 32 approvers and 64 approval files",
        "An approval can be presented to any verifier until it expires; bind one-time actions to unique content such as a nonce in the plan",
        "Not threshold cryptography: each approver signs separately"
      ],
      "prerequisites": [
        "Each approver's identity",
        "The relying party pins every approver's public identity and fingerprint",
        "All approvers approve the same content in the same content mode and action"
      ],
      "sources": [
        "https://csrc.nist.gov/glossary/term/two_person_integrity",
        "https://www.rfc-editor.org/rfc/rfc8785"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/approval.sign",
        "ipg:operation/quorum.verify",
        "ipg:operation/inspect"
      ]
    },
    {
      "@id": "ipg:application/delegate-agent-authority",
      "@type": "ipg:CryptographicApplication",
      "goals": [
        "ipg:goal/delegated-authority",
        "ipg:goal/identity-policy"
      ],
      "guidance": "Issue a short-lived grant naming only the operations and purposes the agent needs, with delegation_depth 0 unless it must re-delegate. Relying parties pass a delegation requirement to verify or stream.verify with the root pinned, and treat a purpose mismatch or expiry as refusal, never as a prompt to widen the grant.",
      "id": "delegate-agent-authority",
      "keywords": [
        "delegation",
        "delegate",
        "agent",
        "multi-agent",
        "on behalf",
        "capability",
        "least privilege",
        "scoped authority"
      ],
      "label": "Delegate scoped signing or decryption authority to an agent",
      "limitations": [
        "Grants are evidence checked at the host clock, not host or filesystem authorization",
        "Purposes are application labels the relying party must interpret",
        "No grant revocation list: keep grants short-lived and revoke compromised keys through trust snapshots",
        "Up to 8 links and depth 7; each link can only narrow its parent"
      ],
      "prerequisites": [
        "The root principal's key and passphrase (or provider credentials) to issue the first grant",
        "Each delegate's public identity and an independently trusted fingerprint",
        "Relying parties hold the root's pinned public identity"
      ],
      "sources": [
        "https://www.w3.org/TR/vc-data-model-2.0/",
        "https://datatracker.ietf.org/doc/html/rfc8693"
      ],
      "support": "implemented",
      "tools": [
        "ipg:operation/grant.issue",
        "ipg:operation/grant.verify",
        "ipg:operation/sign",
        "ipg:operation/verify",
        "ipg:operation/stream.sign",
        "ipg:operation/stream.verify"
      ]
    },
    {
      "@id": "ipg:application/revoke-identity",
